  const W15 = {NLD:'Netherlands', DNK:'Denmark', SWE:'Sweden', DEU:'Germany', FRA:'France',
               GBR:'United Kingdom', USA:'United States', CHN:'China', KOR:'South Korea',
               BRA:'Brazil', JPN:'Japan', IND:'India', PRK:'North Korea', NGA:'Nigeria',
               GTM:'Guatemala'};
  const HIDX = {m:0, w:1};
  /* the map carries a single cohort: h = [male, female] for the 1996 birth year */
  const wh = (k, sxi) => { const h = WORLD[k].h; return h ? h[sxi] / 10 : null; };
  /* the ramp is spent on the fifteen, so it spans their range rather than the world's */
  function domainFor(sx){
    const key = sx === 'm' ? 'm' : 'w';
    const vals = ORDER.map(k => { const a = N15[k][key]; return a[a.length-1]; });
    return [Math.floor(Math.min(...vals)), Math.ceil(Math.max(...vals))];
  }
  const DOM = {m: domainFor('m'), w: domainFor('w')};
  let SX = 'm';                                     // 'm' | 'w'

  const lerpC = (a,b,t) => {
    const p = h => [parseInt(h.slice(1,3),16), parseInt(h.slice(3,5),16), parseInt(h.slice(5,7),16)];
    const A = p(a), B = p(b);
    return 'rgb(' + A.map((v,i) => Math.round(v + (B[i]-v)*t)).join(',') + ')';
  };
  function colFor(cm){
    const [lo,hi] = DOM[SX];
    const t = Math.max(0, Math.min(1, (cm-lo)/(hi-lo))) * (RAMP.length-1);
    const i = Math.min(RAMP.length-2, Math.floor(t));
    return lerpC(RAMP[i], RAMP[i+1], t-i);
  }
  const hv = k => N15[k][SX === 'm' ? 'm' : 'w'];
  const last = a => a[a.length-1];

  /* ---------- canvas + projection ---------- */
  // centroid of the largest ring, for countries outside the curated 15
  (function(){
    for (const k of Object.keys(WORLD)){
      if (CEN[k] || !WORLD[k].h) continue;
      let big = null, ba = -1;
      for (const r of WORLD[k].r){
        let a = 0;
        for (let i = 0; i < r.length; i += 2){
          const j = (i + 2) % r.length;
          a += r[i]*r[j+1] - r[j]*r[i+1];
        }
        a = Math.abs(a)/2;
        if (a > ba){ ba = a; big = r; }
      }
      if (!big) continue;
      let sx = 0, sy = 0, m = 0;
      for (let i = 0; i < big.length; i += 2){ sx += big[i]; sy += big[i+1]; m++; }
      CEN[k] = [+(sx/m).toFixed(1), +(sy/m).toFixed(1)];
    }
  })();

  const cv = document.getElementById('globe'), ctx = cv.getContext('2d');
  const wrap = document.getElementById('gbWrap');
  const RAD = Math.PI/180;
  let W = 0, H = 0, R = 0, DPR = 1;
  const st = {lam: -20, phi: 18, k: 1, flam: 10};             // yaw, pitch, zoom
  let spin = !reduce, sel = null, hot = null, flying = false;

  function size(){
    DPR = Math.min(2, window.devicePixelRatio || 1);
    W = wrap.clientWidth; H = cv.clientHeight;
    cv.width = W*DPR; cv.height = H*DPR;
    ctx.setTransform(DPR,0,0,DPR,0,0);
    R = Math.min(W, H) * 0.42;
  }

  /* morph = 0 -> flat equirectangular map (whole world at a glance)
     morph = 1 -> orthographic globe. Values in between animate the unroll. */
  let morph = 0;
  const flatSc = () => Math.min(W/360, H/152) * 0.99;   // fill the card on wide screens
  function flatPos(lon, lat){
    const sc = flatSc()*st.k;
    return [W/2 + (lon - st.flam)*sc, H/2 - lat*sc*0.95];
  }
  function globePos(lon, lat){
    const l = (lon - st.lam)*RAD, p = lat*RAD, p0 = st.phi*RAD;
    const cp = Math.cos(p), sp = Math.sin(p), cl = Math.cos(l), sl = Math.sin(l);
    const cp0 = Math.cos(p0), sp0 = Math.sin(p0);
    const z = sp0*sp + cp0*cp*cl;
    const rk = R*st.k;
    return [W/2 + rk*(cp*sl), H/2 - rk*(cp0*sp - sp0*cp*cl), z];
  }
  function pr(lon, lat){
    if (morph <= 0.001) return flatPos(lon, lat);
    const g = globePos(lon, lat);
    if (morph >= 0.999) return g[2] <= 0.001 ? null : [g[0], g[1]];
    if (g[2] <= 0.001 && morph > 0.6) return null;
    const f = flatPos(lon, lat);
    return [f[0] + (g[0]-f[0])*morph, f[1] + (g[1]-f[1])*morph];
  }
  const visible = (lon, lat) => {
    if (morph <= 0.6) return true;
    const l = (lon - st.lam)*RAD, p = lat*RAD, p0 = st.phi*RAD;
    return Math.sin(p0)*Math.sin(p) + Math.cos(p0)*Math.cos(p)*Math.cos(l) > 0.02;
  };

  function ringPath(flat, close){
    let started = false, any = false;
    for (let i = 0; i < flat.length; i += 2){
      const q = pr(flat[i], flat[i+1]);
      if (!q){ started = false; continue; }
      if (!started){ ctx.moveTo(q[0], q[1]); started = true; } else ctx.lineTo(q[0], q[1]);
      any = true;
    }
    if (close && any) ctx.closePath();
    return any;
  }

  function draw(){
    ctx.clearRect(0,0,W,H);
    const rk = R*st.k, gl = morph > 0.35;

    ctx.save();
    if (gl){                                       // clip to the sphere once it exists
      ctx.beginPath(); ctx.arc(W/2, H/2, rk, 0, 7); ctx.clip();
      const g = ctx.createRadialGradient(W/2 - rk*.3, H/2 - rk*.35, rk*.1, W/2, H/2, rk);
      g.addColorStop(0, '#fbf8f1'); g.addColorStop(.65, '#f2ece0'); g.addColorStop(1, '#e4dccb');
      ctx.globalAlpha = (morph-0.35)/0.65;
      ctx.fillStyle = g; ctx.fillRect(0,0,W,H);
      ctx.globalAlpha = 1;
    }

    // graticule
    ctx.strokeStyle = 'rgba(25,23,19,.075)'; ctx.lineWidth = .8;
    for (let lat = -60; lat <= 60; lat += 30){
      ctx.beginPath(); let sOn = false;
      for (let lon = -180; lon <= 180; lon += 4){
        const q = pr(lon, lat);
        if (!q){ sOn = false; continue; }
        sOn ? ctx.lineTo(q[0],q[1]) : (ctx.moveTo(q[0],q[1]), sOn = true);
      }
      ctx.stroke();
    }
    for (let lon = -180; lon < 180; lon += 30){
      ctx.beginPath(); let sOn = false;
      for (let lat = -90; lat <= 90; lat += 4){
        const q = pr(lon, lat);
        if (!q){ sOn = false; continue; }
        sOn ? ctx.lineTo(q[0],q[1]) : (ctx.moveTo(q[0],q[1]), sOn = true);
      }
      ctx.stroke();
    }

    /* ---- the backdrop: the rest of the world, deliberately recessed ----
       Held to a flat paper tone so the fifteen are the only thing carrying colour.
       Every one of them still answers on hover and still opens a small file. */
    ctx.lineWidth = .5; ctx.strokeStyle = 'rgba(25,23,19,.16)';
    for (const k of WKEYS){
      const v = wh(k, HIDX[SX]);
      const isHotW = hot === 'W:' + k;
      ctx.fillStyle = isHotW ? 'rgba(196,64,42,.16)'
                    : v == null ? 'rgba(25,23,19,.05)' : 'rgba(25,23,19,.085)';
      for (const r of WORLD[k].r){ ctx.beginPath(); if (ringPath(r, true)){ ctx.fill(); ctx.stroke(); } }
    }

    // ---- the fifteen: the only nations shaded by height, and the only ones with files ----
    for (const k of ORDER){
      const c = CEN[k]; if (!c || !visible(c[0], c[1])) continue;
      const cm = last(hv(k));
      const isSel = sel === k, isHot = hot === k;
      ctx.beginPath();
      for (const r of GEO[k]) ringPath(r, true);
      if (isSel || isHot){                         // a soft halo so the pick reads instantly
        ctx.save();
        ctx.strokeStyle = 'rgba(196,64,42,.28)';
        ctx.lineWidth = isSel ? 7 : 5;
        ctx.stroke();
        ctx.restore();
      }
      ctx.fillStyle = colFor(cm);
      ctx.fill();
      ctx.strokeStyle = isSel ? '#c4402a' : (isHot ? 'rgba(196,64,42,.9)' : 'rgba(25,23,19,.75)');
      ctx.lineWidth = isSel ? 2.2 : (isHot ? 1.8 : 1.3);
      ctx.stroke();
    }

    // on the flat map every nation can be labelled at once — this is the at-a-glance read
    if (morph < 0.3){
      ctx.globalAlpha = 1 - morph/0.3;
      ctx.textAlign = 'center';
      for (const k of ORDER){
        const c = CEN[k]; if (!c) continue;
        const q = pr(c[0], c[1]); if (!q) continue;
        const cm = last(hv(k)), lab = cm.toFixed(1);
        const hotly = (hot === k || sel === k);
        ctx.font = (hotly ? '700 ' : '700 ') + (hotly ? 10 : 8.5) + 'px "Space Mono", monospace';
        const wd = ctx.measureText(lab).width + 8;
        ctx.fillStyle = hotly ? '#c4402a' : 'rgba(250,247,240,.88)';
        ctx.strokeStyle = hotly ? '#c4402a' : 'rgba(25,23,19,.45)';
        ctx.lineWidth = 1;
        const bx = q[0]-wd/2, byy = q[1]-6, bh = 13;
        ctx.beginPath(); ctx.rect(bx, byy, wd, bh); ctx.fill(); ctx.stroke();
        ctx.fillStyle = hotly ? '#faf7f0' : '#191713';
        ctx.fillText(lab, q[0], byy + 9.5);
      }
      ctx.globalAlpha = 1;
      ctx.textAlign = 'start';
    }

    // fly-in reticle
    if (flying || sel){
      const t = performance.now()/1000;
      ctx.strokeStyle = 'rgba(196,64,42,.5)'; ctx.lineWidth = 1;
      for (let i = 0; i < 2; i++){
        const rr = 14 + ((t*40 + i*22) % 44);
        ctx.globalAlpha = 1 - rr/58;
        ctx.beginPath(); ctx.arc(W/2, H/2, rr, 0, 7); ctx.stroke();
      }
      ctx.globalAlpha = 1;
      ctx.strokeStyle = 'rgba(196,64,42,.8)';
      ctx.beginPath();
      ctx.moveTo(W/2-9,H/2); ctx.lineTo(W/2-3,H/2); ctx.moveTo(W/2+3,H/2); ctx.lineTo(W/2+9,H/2);
      ctx.moveTo(W/2,H/2-9); ctx.lineTo(W/2,H/2-3); ctx.moveTo(W/2,H/2+3); ctx.lineTo(W/2,H/2+9);
      ctx.stroke();
    }
    ctx.restore();

    if (gl){                                       // limb + soft atmosphere
      ctx.globalAlpha = (morph-0.35)/0.65;
      const ag = ctx.createRadialGradient(W/2, H/2, rk*.97, W/2, H/2, rk*1.06);
      ag.addColorStop(0, 'rgba(184,134,59,.16)'); ag.addColorStop(1, 'rgba(184,134,59,0)');
      ctx.fillStyle = ag; ctx.beginPath(); ctx.arc(W/2,H/2,rk*1.06,0,7); ctx.fill();
      ctx.strokeStyle = 'rgba(25,23,19,.4)'; ctx.lineWidth = 1.1;
      ctx.beginPath(); ctx.arc(W/2, H/2, rk, 0, 7); ctx.stroke();
      ctx.globalAlpha = 1;
    }
  }

  /* ---------- animation loop ---------- */
  function tick(){
    if (spin && morph > 0.5 && !flying && !sel) st.lam = (st.lam + 0.16) % 360;
    draw();
    requestAnimationFrame(tick);
  }

  const ease = t => t < .5 ? 4*t*t*t : 1 - Math.pow(-2*t+2, 3)/2;
  function flyTo(k, then){
    const c = CEN[k];
    const m0 = morph;
    // from the flat map, aim the globe at the target before it forms
    if (m0 < 0.5){ st.lam = c[0]; st.phi = Math.max(-70, Math.min(70, c[1])); }
    let dl = ((c[0] - st.lam + 540) % 360) - 180;      // shortest way round
    const l0 = st.lam, p0 = st.phi, k0 = st.k;
    const l1 = l0 + dl, p1 = Math.max(-70, Math.min(70, c[1])), k1 = 2.45;
    if (reduce){ morph = 1; st.lam = l1; st.phi = p1; st.k = k1; setMode(); draw(); then && then(); return; }
    flying = true; wrap.parentElement.classList.add('globe-flying');
    const T = m0 < 0.5 ? 1750 : 1250, t0 = performance.now();
    (function step(now){
      const t = Math.min((now - t0)/T, 1);
      // phase 1: unroll the flat map into a globe · phase 2: turn · phase 3: dive
      morph = m0 + (1-m0) * ease(Math.min(1, t/(m0 < 0.5 ? .45 : .01)));
      const turn = ease(Math.max(0, (t - (m0 < 0.5 ? .3 : 0)) / (m0 < 0.5 ? .7 : 1)));
      st.lam = l0 + dl*turn;
      st.phi = p0 + (p1-p0)*turn;
      const z = Math.max(0, (t - (m0 < 0.5 ? .55 : .22)) / (m0 < 0.5 ? .45 : .78));
      st.k = k0 + (k1-k0)*ease(Math.min(1, z));
      if (t < 1) requestAnimationFrame(step);
      else { flying = false; morph = 1; setMode();
             wrap.parentElement.classList.remove('globe-flying'); then && then(); }
    })(performance.now());
  }
  function flyOut(toFlat){
    const k0 = st.k, p0 = st.phi, m0 = morph, t0 = performance.now();
    const m1 = toFlat ? 0 : m0;
    if (reduce){ st.k = 1; st.phi = 18; morph = m1; setMode(); return; }
    flying = true;
    (function step(now){
      const t = Math.min((now - t0)/900, 1), e = ease(t);
      st.k = k0 + (1-k0)*e; st.phi = p0 + (18-p0)*e;
      morph = m0 + (m1-m0)*ease(Math.max(0, (t-.25)/.75));
      if (t < 1) requestAnimationFrame(step);
      else { flying = false; morph = m1; setMode(); }
    })(performance.now());
  }

  /* ---------- hit testing ---------- */
  function inRing(flat, x, y){
    let inside = false, px = null, py = null, fx = null, fy = null;
    for (let i = 0; i < flat.length; i += 2){
      const q = pr(flat[i], flat[i+1]);
      if (!q){ px = null; continue; }
      if (fx === null){ fx = q[0]; fy = q[1]; }
      if (px !== null){
        if (((q[1] > y) !== (py > y)) && (x < (px - q[0])*(y - q[1])/(py - q[1]) + q[0])) inside = !inside;
      }
      px = q[0]; py = q[1];
    }
    if (px !== null && fx !== null){
      if (((fy > y) !== (py > y)) && (x < (px - fx)*(y - fy)/(py - fy) + fx)) inside = !inside;
    }
    return inside;
  }
  function pick(x, y){
    for (const k of ORDER){
      const c = CEN[k]; if (!c || !visible(c[0], c[1])) continue;
      for (const r of GEO[k]) if (inRing(r, x, y)) return k;
    }
    // then any of the other countries on the map
    for (const k of WKEYS){
      if (WORLD[k].h == null) continue;
      for (const r of WORLD[k].r) if (inRing(r, x, y)) return 'W:' + k;
    }
    // fallback: nearest centroid inside a minimum grab radius, so the Netherlands,
    // Denmark, the Koreas and Guatemala stay clickable when they are a few pixels wide
    const GRAB = morph < 0.5 ? 15 : 13;
    let best = null, bd = GRAB*GRAB;
    for (const k of ORDER){
      const c = CEN[k]; if (!c || !visible(c[0], c[1])) continue;
      const q = pr(c[0], c[1]); if (!q) continue;
      const d = (q[0]-x)*(q[0]-x) + (q[1]-y)*(q[1]-y);
      if (d < bd){ bd = d; best = k; }
    }
    return best;
  }

  /* ---------- pointer ---------- */
  const tip = document.getElementById('gbTip');
  let drag = null, moved = 0;
  cv.addEventListener('pointerdown', e => {
    drag = {x:e.clientX, y:e.clientY, lam:st.lam, phi:st.phi, flam:st.flam}; moved = 0;
    try { cv.setPointerCapture(e.pointerId); } catch(_){}
    cv.classList.add('grabbing');
  });
  cv.addEventListener('pointermove', e => {
    const r = cv.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
    if (drag){
      moved += Math.abs(e.clientX - drag.x) + Math.abs(e.clientY - drag.y);
      if (morph < 0.5){
        st.flam = drag.flam - (e.clientX - drag.x) / (flatSc()*st.k);
      } else {
        st.lam = drag.lam - (e.clientX - drag.x) * 0.32 / st.k;
        st.phi = Math.max(-80, Math.min(80, drag.phi + (e.clientY - drag.y) * 0.32 / st.k));
      }
      return;
    }
    const k = pick(x, y);
    hot = k;
    cv.classList.toggle('pickable', !!k);
    setHot(k);
    if (k){
      tip.classList.add('on'); tip.style.left = x + 'px'; tip.style.top = y + 'px';
      // one dataset per tooltip: whatever the map is currently shaded by
      const wk = k.startsWith('W:') ? k.slice(2) : W15[k];
      const v = wk && WORLD[wk] ? wh(wk, HIDX[SX]) : null;
      const nm = k.startsWith('W:') ? WORLD[wk].n : (N15[k].f + ' ' + N15[k].n);
      tip.innerHTML = nm + ' · <b>' + (v == null ? 'no data' : v.toFixed(1) + ' cm</b>')
                    + (k.startsWith('W:') ? '' : ' · <span style="opacity:.75">has a file</span>');
    } else tip.classList.remove('on');
  });
  cv.addEventListener('pointerup', e => {
    cv.classList.remove('grabbing');
    const wasDrag = moved > 6; drag = null;
    if (wasDrag) return;
    const r = cv.getBoundingClientRect();
    const k = pick(e.clientX - r.left, e.clientY - r.top);
    if (k) select(k);
  });
  cv.addEventListener('pointerleave', () => { tip.classList.remove('on'); hot = null; setHot(null); });

  /* ---------- ranked list ---------- */
  const rkList = document.getElementById('rkList');   // widget removed from page 03
  function buildRank(){
    if (!rkList) return;
    const ranked = ORDER.slice().sort((a,b) => last(hv(b)) - last(hv(a)));
    const [lo,hi] = DOM[SX];
    rkList.innerHTML = ranked.map((k,i) => {
      const cm = last(hv(k));
      const w = Math.max(4, (cm-lo)/(hi-lo)*100);
      return `<button class="rk" data-k="${k}" aria-label="${N15[k].n}, ${cm.toFixed(1)} centimetres, rank ${i+1} of 15. Opens the deep dive.">
        <span class="p">${i+1}</span><span class="fl">${N15[k].f}</span>
        <span class="cell"><span class="nm">${N15[k].n}</span><span class="vb"><i style="width:${w.toFixed(0)}%;background:${colFor(cm)}"></i></span></span>
        <span class="vl">${cm.toFixed(1)}</span></button>`;
    }).join('');
    [...rkList.children].forEach(b => {
      b.addEventListener('click', () => select(b.dataset.k));
      b.addEventListener('pointerenter', () => { hot = b.dataset.k; });
      b.addEventListener('pointerleave', () => { hot = null; });
    });
    markSel();
  }
  function setHot(k){ if (rkList) [...rkList.children].forEach(b => b.classList.toggle('hot', b.dataset.k === k)); }
  function markSel(){ if (rkList) [...rkList.children].forEach(b => b.classList.toggle('sel', b.dataset.k === sel)); }

  /* ---------- deep dive ---------- */
  const deep = document.getElementById('deep');
  const spark = (v, col, inv) => {
    const ok = v.filter(x => x != null);
    if (!ok.length) return '<svg viewBox="0 0 100 22"><text x="0" y="15" font-family="monospace" font-size="9.5" fill="#6f6a5e">no data</text></svg>';
    const lo = Math.min(...ok), hi = Math.max(...ok), sp = (hi-lo) || 1;
    const pts = v.map((x,i) => x == null ? null : [i/(v.length-1)*100, 20 - ((x-lo)/sp)*18])
                 .filter(Boolean).map(p => p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
    return `<svg viewBox="0 0 100 22" preserveAspectRatio="none">
      <polyline points="${pts}" fill="none" stroke="${col}" stroke-width="1.6" vector-effect="non-scaling-stroke"/>
    </svg>`;
  };
  const DRVDEF = [
    {k:'protein', l:'Protein supply', u:' g/day', p:'real', c:'#7d5420'},
    {k:'sanit',   l:'Sanitation',     u:'%',      p:'real', c:'#2f6b6b'},
    {k:'uhc',     l:'Healthcare index', u:'',     p:'mod',  c:'#6b4a6b'},
    {k:'edu',     l:'Education years', u:' yrs',  p:'mod',  c:'#4a5a6b'},
    {k:'pm25',    l:'PM2.5 pollution', u:' µg',   p:'real', c:'#8c3a2a'},
    {k:'gdp',     l:'GDP per capita',  u:'',      p:'real', c:'#3f6b4a'}
  ];
  const money = v => v == null ? 'n/a' : '$' + (v >= 1000 ? (v/1000).toFixed(1) + 'k' : Math.round(v));

  /* data-quality warnings, shown on the files that need them */
  const DQ = {
    PRK: '<b>Read this file with care.</b> North Korea has the widest uncertainty interval of all 200 ' +
         'countries in the NCD-RisC release — the 1996 cohort is 173.7 cm with a 95% interval of ' +
         '<b>162.0 to 186.3 cm</b>, a band 24 cm wide, because there is effectively no primary survey ' +
         'data for the DPRK. Sanitation, healthcare spending and GDP are missing outright. The height ' +
         'line above is a point estimate, not a measurement you can lean on.'
  };

  function select(k){
    if (k && k.startsWith('W:')) return selectWorld(k.slice(2));
    sel = k; markSel();
    fillDeep(k);                                   // content lands in the DOM immediately
    if (reduce){ reveal(); return; }               // no flight, and no projection jump
    flyTo(k, reveal);                              // panel expands as the globe touches down
  }
  /* countries outside the spotlight 15 still get a small honest file */
  function selectWorld(key){
    const w = WORLD[key];
    const bs = wh(key, 0), gs = wh(key, 1);
    const ranked = WKEYS.filter(x => WORLD[x].h).map(x => wh(x, HIDX[SX]))
                        .sort((a,b) => b - a);
    const me = wh(key, HIDX[SX]);
    const rank = ranked.indexOf(me) + 1;
    sel = null; markSel();
    document.getElementById('dpFlag').textContent = '🗺';
    document.getElementById('dpName').textContent = w.n;
    document.getElementById('dpSub').textContent = 'Shaded on the map · no model file';
    document.getElementById('dpH').textContent = me == null ? '—' : me.toFixed(1);
    document.getElementById('dpHl').textContent = 'CM · 1996 · ' + (SX === 'm' ? 'BOYS 19' : 'GIRLS 19');
    document.getElementById('dpTraj').innerHTML =
      `<div class="dsp-t"><span>Boys, age 19</span><b>${bs == null ? '—' : bs.toFixed(1) + ' cm'}</b></div>
       <div class="dsp-t"><span>Girls, age 19</span><b>${gs == null ? '—' : gs.toFixed(1) + ' cm'}</b></div>
       <div class="dsp-t" style="margin-top:8px"><span>Sex gap</span><b>${
         (bs == null || gs == null) ? '—' : (bs-gs).toFixed(1) + ' cm'}</b></div>
       <div class="dsp-t"><span>Rank of ${ranked.length} shaded countries</span><b>#${rank}</b></div>`;
