    const cm = Math.max(0, (BASE_Y - svgY) / PX_PER_CM);
    calVal.textContent = cm.toFixed(1) + ' cm';
    figs.forEach(f => f.classList.toggle('dim', parseFloat(f.dataset.cm) < cm));
  }, {passive:true});

  plot.addEventListener('pointerleave', () => figs.forEach(f => f.classList.remove('dim')));

  /* ---------------------------------------------------------
     4. STAT COUNTERS
     --------------------------------------------------------- */
  const fmt = (n, dec) => n.toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec});
  document.querySelectorAll('.v[data-to]').forEach((el,i) => {
    const to = parseFloat(el.dataset.to);
    const dec = parseInt(el.dataset.dec || 0, 10);
    const sfx = el.dataset.suffix || '';
    el.dataset.settled = fmt(to,dec)+sfx;          // final value (the display counts up to it)
    if (reduce) { el.textContent = fmt(to,dec)+sfx; return; }
    const dur = 1500, delay = 500 + i*110;
    setTimeout(() => {
      const t0 = performance.now();
      (function step(now){
        const p = Math.min((now - t0)/dur, 1);
        const e = 1 - Math.pow(1-p, 3);                 // easeOutCubic
        el.textContent = fmt(to*e, dec) + sfx;
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = fmt(to,dec)+sfx;
      })(performance.now());
    }, delay);
  });

  /* ---------------------------------------------------------
     5. GO
     --------------------------------------------------------- */
  requestAnimationFrame(()=>document.body.classList.add('loaded'));
})();
</script>

