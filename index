  /* ---------------------------------------------------------
     monotone cubic interpolation (Fritsch–Carlson): smooth, no overshoot
     --------------------------------------------------------- */
  function spline(xs, ys){
    const n = xs.length, m = [], t = [];
    for (let i = 0; i < n-1; i++) m.push((ys[i+1]-ys[i])/(xs[i+1]-xs[i]));
    t.push(m[0]);
    for (let i = 1; i < n-1; i++) t.push(m[i-1]*m[i] <= 0 ? 0 : (m[i-1]+m[i])/2);
    t.push(m[n-2]);
    for (let i = 0; i < n-1; i++){
      if (m[i] === 0){ t[i] = 0; t[i+1] = 0; continue; }
      const a = t[i]/m[i], b = t[i+1]/m[i], h = Math.hypot(a,b);
      if (h > 3){ t[i] = 3*m[i]*a/h; t[i+1] = 3*m[i]*b/h; }
    }
    return x => {
      if (x <= xs[0]) return ys[0];
      if (x >= xs[n-1]) return ys[n-1];
      let i = n-2; while (x < xs[i]) i--;
      const h = xs[i+1]-xs[i], s = (x-xs[i])/h, s2 = s*s, s3 = s2*s;
      return (2*s3-3*s2+1)*ys[i] + (s3-2*s2+s)*h*t[i]
           + (-2*s3+3*s2)*ys[i+1] + (s3-s2)*h*t[i+1];
    };
  }
