  live.setAttribute('aria-atomic', 'true');
  document.body.appendChild(live);
  let lastSaid = '';
  function announce(t){ if (t && t !== lastSaid){ lastSaid = t; live.textContent = t; } }

  /* ---------- one panel per chapter ---------- */
  const byKey = {}; CH.forEach(c => byKey[c.key] = c);
  const panels = [];
  MAP.forEach(([sel, key]) => {
    const sec = document.querySelector(sel), c = byKey[key];
    if (!sec || !c) return;
    const d = document.createElement('details');
    d.className = 'ez';
    d.innerHTML =
      '<summary>In plain words \u00b7 listen \u00b7 see the numbers</summary>' +
      '<div class="ez-body">' +
        '<p class="ez-say">' + c.say + '</p>' +
        '<div class="ez-actions">' +
          '<button type="button" class="ez-play"><span aria-hidden="true">\u25b6</span> Read this aloud</button>' +
          '<button type="button" class="ez-stop"><span aria-hidden="true">\u25a0</span> Stop</button>' +
        '</div>' +
        '<table><caption>' + c.title + ' \u2014 the numbers behind this chapter</caption>' +
          '<thead><tr>' + c.rows[0].split(',').map(h => '<th scope="col">' + h + '</th>').join('') + '</tr></thead>' +
          '<tbody>' + c.rows.slice(1).map(r =>
              '<tr>' + r.split(',').map((v,i) =>
                 i === 0 ? '<th scope="row">' + v + '</th>' : '<td>' + v + '</td>').join('') + '</tr>').join('') +
          '</tbody>' +
        '</table>' +
        '<p class="ez-live">Spoken words appear here as text, so nothing is audio only.</p>' +
      '</div>';
    // put it right under the chapter heading where possible
    const h = sec.querySelector('h1,h2');
    if (h && h.parentNode) h.parentNode.insertBefore(d, h.nextSibling);
    else sec.insertBefore(d, sec.firstChild);
    panels.push({el:d, c:c, sec:sec});
  });

  /* ---------- speech: read aloud, with the text shown as it goes ---------- */
  const canSpeak = 'speechSynthesis' in window;
  let current = null;
  function stopSpeech(){
    if (canSpeak) window.speechSynthesis.cancel();
    html.removeAttribute('data-a11y-speaking');
    panels.forEach(p => p.el.removeAttribute('data-active'));
    document.querySelectorAll('.ez-play').forEach(b => b.setAttribute('aria-pressed','false'));
    current = null;
  }
  function speak(p, btn){
    if (!canSpeak){
      p.el.querySelector('.ez-live').textContent =
        'This browser cannot read text aloud. The full wording is printed above.';
      return;
    }
    stopSpeech();
    p.el.setAttribute('open','');
    p.el.setAttribute('data-active','');
    html.setAttribute('data-a11y-speaking','on');
    btn.setAttribute('aria-pressed','true');
    const u = new SpeechSynthesisUtterance(p.c.title + '. ' + p.c.say);
    u.rate = 0.92; u.pitch = 1;
    u.onend = stopSpeech; u.onerror = stopSpeech;
    current = u;
    window.speechSynthesis.speak(u);
    p.el.querySelector('.ez-live').textContent = 'Now reading: ' + p.c.title;
  }
  panels.forEach(p => {
    p.el.querySelector('.ez-play').addEventListener('click', e => speak(p, e.currentTarget));
    p.el.querySelector('.ez-stop').addEventListener('click', stopSpeech);
  });
  window.addEventListener('beforeunload', stopSpeech);

  /* ---------- the toolbar ---------- */
  const bar = document.createElement('div');
  bar.id = 'a11yBar';
  bar.setAttribute('role','toolbar');
  bar.setAttribute('aria-label','Accessibility tools');
  const BTN = [
    ['read',  '\u25b6', 'Read page',  'Read this chapter aloud'],
    ['plain', '\u2637', 'Plain words','Open the plain words and the numbers for every chapter'],
    ['big',   'A+',     'Bigger',     'Make all the text bigger'],
    ['small', 'A-',     'Smaller',    'Make all the text smaller'],
    ['dys',   '\u0041\u0332','Easy font','Switch to a dyslexia friendly font'],
    ['con',   '\u25d0', 'Contrast',   'Turn up the contrast'],
    ['still', '\u23f8', 'Stop motion','Stop all movement and animation']
  ];
  bar.innerHTML = BTN.map(([id,ic,lab,desc]) =>
    '<button type="button" id="a11y-'+id+'" aria-pressed="false" title="'+desc+'" aria-label="'+desc+'">' +
    '<span class="i" aria-hidden="true">'+ic+'</span>'+lab+'</button>').join('');
  document.body.appendChild(bar);
  const B = id => document.getElementById('a11y-'+id);

  /* text size */
  let step = 0;
  const applyStep = () => { html.style.fontSize = (100 + step*12.5) + '%';
                            B('big').setAttribute('aria-pressed', step > 0 ? 'true':'false');
                            B('small').setAttribute('aria-pressed', step < 0 ? 'true':'false');
                            announce('Text size ' + (100 + step*12.5) + ' percent'); };
  B('big').addEventListener('click', () => { step = Math.min(step+1, 4); applyStep(); });
  B('small').addEventListener('click', () => { step = Math.max(step-1, -1); applyStep(); });

  /* toggles */
  function toggle(id, attr, onMsg, offMsg){
    const b = B(id);
    b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', on ? 'true':'false');
      if (on) html.setAttribute(attr,'on'); else html.removeAttribute(attr);
      announce(on ? onMsg : offMsg);
    });
  }
  toggle('dys','data-a11y-font','Dyslexia friendly font on','Dyslexia friendly font off');
  toggle('con','data-a11y-contrast','High contrast on','High contrast off');
  toggle('still','data-a11y-still','Motion stopped','Motion allowed');

  /* open every plain-words panel at once */
  B('plain').addEventListener('click', () => {
    const b = B('plain');
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', on ? 'true':'false');
    panels.forEach(p => { if (on) p.el.setAttribute('open',''); else p.el.removeAttribute('open'); });
    announce(on ? 'Plain words and data tables opened for every chapter'
               : 'Plain words closed');
    if (on) panels[0] && panels[0].el.scrollIntoView({block:'nearest'});
  });

  /* read whichever chapter is on screen */
  B('read').addEventListener('click', () => {
    if (current){ stopSpeech(); B('read').setAttribute('aria-pressed','false'); return; }
    let best = panels[0], bestD = 1e9;
    panels.forEach(p => {
      const r = p.sec.getBoundingClientRect();
      const d = Math.abs(r.top + r.height/2 - window.innerHeight/2);
      if (r.bottom > 0 && r.top < window.innerHeight && d < bestD){ bestD = d; best = p; }
    });
    if (!best) return;
    B('read').setAttribute('aria-pressed','true');
    speak(best, best.el.querySelector('.ez-play'));
    best.el.scrollIntoView({block:'nearest'});
