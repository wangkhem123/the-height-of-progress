         <svg x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${w.toFixed(1)}" height="${h.toFixed(1)}"
              viewBox="0 0 30 162" preserveAspectRatio="none"><path class="fig-body" d="${BODY}"/></svg>
       </g>
       <text class="fig-cm"   x="${cx.toFixed(1)}" y="${(y-12).toFixed(1)}" text-anchor="middle"
             style="transition-delay:${(0.9 + i*0.09).toFixed(2)}s">${d.cm}</text>
       <text class="fig-name" x="${cx.toFixed(1)}" y="${BASE_Y+14}" text-anchor="middle">${d.c}</text>
       ${d.tag ? `<text class="fig-rank" x="${cx.toFixed(1)}" y="${BASE_Y+24}" text-anchor="middle">${d.tag}</text>` : ''}`;
