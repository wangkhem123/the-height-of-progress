  /* ---------- narrate anything that animates, for screen readers ---------- */
  const yearEl = document.getElementById('yearNow') || document.getElementById('slYear')
              || document.getElementById('mYear');
  if (yearEl){
    let t = 0;
    new MutationObserver(() => {
      clearTimeout(t);
      t = setTimeout(() => {
        const lead = document.querySelector('#standings .st-row .n, #rkList .rk .nm');
        announce('Year ' + yearEl.textContent.trim() +
                 (lead ? '. Tallest: ' + lead.textContent.trim() : ''));
      }, 700);                                  /* throttled, so it never floods */
    }).observe(yearEl, {childList:true, characterData:true, subtree:true});
  }

  /* ---------- respect the operating system ---------- */
  if (window.matchMedia('(prefers-contrast: more)').matches) B('con').click();
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    B('still').setAttribute('aria-pressed','true'); html.setAttribute('data-a11y-still','on');
  }
})();
</script>
