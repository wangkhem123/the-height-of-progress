<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Tape Measure Never Lies — A Century of Human Height</title>
<script>document.documentElement.className='js';</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,600;0,6..96,700;1,6..96,400;1,6..96,700&family=Space+Mono:wght@400;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
/* ============================================================
   THEME — "ANTHROPOMETRIC FIELD NOTEBOOK"
   Bone paper, drafting grid, ink & vermillion. Not a dark theme.
   ============================================================ */
*{margin:0;padding:0;box-sizing:border-box}

:root{
  --paper:#f1ece1;
  --paper-2:#e9e3d5;
  --card:#faf7f0;
  --ink:#191713;
  --ink-soft:#4a453c;
  --pencil:#6f6a5e;
  --rule:rgba(25,23,19,.14);
  --red:#c4402a;
  --blue:#2f4b6e;
  --display:'Bodoni Moda',Didot,'Times New Roman',serif;
  --mono:'Space Mono','SFMono-Regular',Menlo,monospace;
  --body:'Inter',system-ui,-apple-system,sans-serif;
  --spine:64px;
}

html{scroll-behavior:smooth}
section[id]{scroll-margin-top:18px}

body{
  font-family:var(--body);
  background:var(--paper);
  color:var(--ink);
  line-height:1.65;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}

/* ---------- drafting grid + paper grain ---------- */
.paper-grid,.paper-grain{position:fixed;inset:0;pointer-events:none;z-index:0}
.paper-grid{
  background-image:
    linear-gradient(to right,rgba(25,23,19,.055) 1px,transparent 1px),
    linear-gradient(to bottom,rgba(25,23,19,.055) 1px,transparent 1px),
    linear-gradient(to right,rgba(25,23,19,.045) 1px,transparent 1px),
    linear-gradient(to bottom,rgba(25,23,19,.045) 1px,transparent 1px);
  background-size:26px 26px,26px 26px,130px 130px,130px 130px;
}
.paper-grain{
  opacity:.4;mix-blend-mode:multiply;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)' opacity='.28'/></svg>");
}
/* warm vignette so the paper feels lit, not flat */
.paper-glow{position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(120% 80% at 30% 0%,rgba(255,252,244,.9),transparent 60%),
             radial-gradient(90% 70% at 100% 100%,rgba(196,64,42,.05),transparent 60%)}

/* ============================================================
   LEFT SPINE — a live measuring tape down the page edge
   ============================================================ */
.spine{
  position:fixed;left:0;top:0;bottom:0;width:var(--spine);z-index:20;
  background:linear-gradient(to right,var(--paper-2),rgba(233,227,213,.4));
  border-right:1px solid var(--rule);
}
.spine-ticks{position:absolute;inset:0}
.spine-tick{position:absolute;right:0;height:1px;background:var(--rule)}
.spine-tick.minor{width:9px}
.spine-tick.major{width:20px;background:rgba(25,23,19,.32)}
.spine-num{position:absolute;right:24px;font-family:var(--mono);font-size:9px;color:var(--pencil);transform:translateY(-50%);letter-spacing:.5px}
.spine-cursor{position:absolute;left:0;right:0;height:0;border-top:1.5px solid var(--red);transition:top .06s linear;will-change:top}
.spine-cursor::after{
  content:attr(data-read);position:absolute;left:6px;top:4px;
  font-family:var(--mono);font-size:9px;font-weight:700;color:var(--red);letter-spacing:.5px;white-space:nowrap
}
.spine-label{
  position:absolute;bottom:26px;left:50%;transform:translateX(-50%) rotate(180deg);writing-mode:vertical-rl;
  font-family:var(--mono);font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--pencil)
}

/* ============================================================
   LAYOUT
   ============================================================ */
.stage{position:relative;z-index:1;padding-left:var(--spine)}

.topbar{
  display:flex;justify-content:space-between;align-items:baseline;gap:20px;
  padding:22px clamp(20px,4vw,56px) 0;
  font-family:var(--mono);font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:var(--pencil)
}
.topbar .dot{display:inline-block;width:7px;height:7px;background:var(--red);margin-right:9px;vertical-align:1px}

/* ============================================================
   CONTENTS — jump to any chapter
   ============================================================ */
.toc{padding:14px clamp(20px,4vw,56px) 0;max-width:1520px;margin:0 auto}
.toc-k{
  font-family:var(--mono);font-size:9px;letter-spacing:3.2px;text-transform:uppercase;
  color:var(--pencil);margin-bottom:9px;display:flex;align-items:center;gap:10px}
.toc-k::after{content:'';flex:1;height:1px;background:var(--rule)}
.toc-l{
  list-style:none;margin:0;padding:0;
  display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px}
.toc-l a{
  display:flex;flex-direction:column;gap:2px;height:100%;
  padding:9px 11px 10px;text-decoration:none;color:inherit;
  background:var(--card);border:1px solid var(--rule);border-top:2px solid rgba(25,23,19,.34);
  border-radius:0 0 2px 2px;
  transition:border-top-color .18s,background .18s,transform .18s,box-shadow .18s}
.toc-l a:hover{
  border-top-color:var(--red);background:rgba(196,64,42,.04);
  transform:translateY(-2px);box-shadow:2px 4px 0 rgba(25,23,19,.07)}
.toc-l a:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.toc-l a[aria-current="true"]{border-top-color:var(--red);background:rgba(196,64,42,.06)}
.toc-n{font-family:var(--mono);font-size:8.5px;letter-spacing:1.6px;color:var(--red)}
.toc-t{
  font-family:var(--display);font-size:.94rem;font-weight:700;line-height:1.2;color:var(--ink)}
.toc-d{
  font-family:var(--mono);font-size:8.5px;letter-spacing:.4px;color:var(--pencil);line-height:1.45}
@media (max-width:1080px){ .toc-l{grid-template-columns:repeat(3,minmax(0,1fr))} }
@media (max-width:620px){ .toc-l{grid-template-columns:repeat(2,minmax(0,1fr))} .toc-d{display:none} }

.hero{
  min-height:calc(100vh - 60px);
  display:grid;grid-template-columns:1.12fr .88fr;gap:clamp(28px,4.5vw,72px);
  align-items:center;
  padding:clamp(24px,4vh,56px) clamp(20px,4vw,56px) 64px;
  max-width:1520px;margin:0 auto;
}

/* ---------- headline block ---------- */
.eyebrow{
  font-family:var(--mono);font-size:10.5px;letter-spacing:3.5px;text-transform:uppercase;
  color:var(--ink-soft);display:flex;align-items:center;gap:12px;margin-bottom:22px
}
.eyebrow::before{content:'';width:44px;height:1px;background:var(--red)}

h1{
  font-family:var(--display);
  font-size:clamp(2.9rem,6.6vw,6.1rem);
  font-weight:700;line-height:.94;letter-spacing:-.02em;
  text-transform:none;
}
h1 .tagline{display:block;font-size:.34em;line-height:1.15;letter-spacing:0;margin-top:.55em}
h1 .em{font-style:italic;font-weight:400;color:var(--red);display:block}
h1 .em .strike{position:relative;display:inline-block}
h1 .em .strike::after{
  content:'';position:absolute;left:-2%;right:-2%;top:56%;height:3px;background:var(--red);
  transform:scaleX(0);transform-origin:left;transition:transform 1s cubic-bezier(.2,.7,.2,1) .9s
}
.loaded h1 .em .strike::after{transform:scaleX(1)}

.deck{
  font-family:var(--display);font-size:clamp(1.05rem,1.6vw,1.4rem);font-weight:400;font-style:italic;
  color:var(--ink-soft);margin-top:20px;max-width:46ch;line-height:1.5
}

.hook{
  margin-top:26px;padding-left:20px;border-left:2px solid var(--ink);
  max-width:50ch;font-size:.97rem;color:var(--ink-soft)
}
.hook b{color:var(--ink);font-weight:500}

/* ---------- stat tags ---------- */
.stats{
  display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:clamp(30px,4vh,46px);max-width:760px
}
.stat{
  position:relative;background:var(--card);border:1px solid var(--rule);border-radius:2px;
  padding:16px 14px 14px;
  box-shadow:2px 3px 0 rgba(25,23,19,.06);
  transition:transform .3s cubic-bezier(.2,.7,.2,1),box-shadow .3s,border-color .3s;
  cursor:default;
}
.stat:nth-child(odd){transform:rotate(-.7deg)}
.stat:nth-child(even){transform:rotate(.55deg)}
.stat:hover{transform:rotate(0) translateY(-5px);box-shadow:4px 7px 0 rgba(25,23,19,.1);border-color:rgba(196,64,42,.5)}
.stat::before{ /* punched hole, notebook tag */
  content:'';position:absolute;top:8px;right:9px;width:7px;height:7px;border:1px solid var(--pencil);border-radius:50%
}
.stat .k{font-family:var(--mono);font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--pencil)}
.stat .v{
  font-family:var(--display);font-weight:700;font-size:clamp(1.9rem,3.1vw,2.7rem);
  line-height:1;margin:8px 0 5px;letter-spacing:-.02em;font-variant-numeric:tabular-nums
}
.stat:nth-child(1) .v{color:var(--ink)}
.stat:nth-child(2) .v{color:var(--blue)}
.stat:nth-child(3) .v{color:var(--red)}
.stat:nth-child(4) .v{color:var(--ink)}
.stat .l{font-size:.78rem;color:var(--ink-soft);line-height:1.35}
.stat .src{
  font-family:var(--mono);font-size:9.5px;letter-spacing:.6px;color:var(--pencil);
  margin-top:9px;padding-top:8px;border-top:1px dashed var(--rule);
  opacity:0;transform:translateY(-3px);transition:opacity .3s,transform .3s
}
.stat:hover .src{opacity:1;transform:none}

/* ---------- rubber stamp ---------- */
.stamp{
  display:inline-block;margin-top:30px;padding:9px 16px;
  border:1.5px solid rgba(196,64,42,.55);border-radius:3px;transform:rotate(-3.2deg);
  font-family:var(--mono);font-size:9.5px;letter-spacing:3px;text-transform:uppercase;
  color:rgba(196,64,42,.8);opacity:.85
}
.stamp span{color:rgba(196,64,42,.5)}

/* ============================================================
   RIGHT — SPECIMEN PLATE (interactive caliper)
   ============================================================ */
.plate{
  background:var(--card);border:1px solid rgba(25,23,19,.28);border-radius:2px;
  padding:16px 16px 12px;box-shadow:3px 5px 0 rgba(25,23,19,.07);position:relative
}
.plate-head{
  display:flex;justify-content:space-between;align-items:baseline;gap:12px;
  padding-bottom:10px;margin-bottom:12px;border-bottom:1px solid var(--rule);
  font-family:var(--mono);font-size:9px;letter-spacing:1.8px;text-transform:uppercase;color:var(--pencil)
}
.plate-head b{color:var(--ink);letter-spacing:2px}
.plate-sx{display:flex;align-items:center;gap:6px}
.plate-sx em{font-style:normal;margin-left:4px;color:var(--pencil);letter-spacing:1.8px}
.pl-sx{
  font-family:var(--mono);font-size:9px;letter-spacing:1.2px;padding:3px 8px;cursor:pointer;
  background:transparent;border:1px solid rgba(25,23,19,.3);color:var(--ink-soft);border-radius:2px;
  transition:background .18s,color .18s,border-color .18s}
.pl-sx:hover{border-color:var(--ink)}
.pl-sx.on{background:var(--ink);color:var(--card);border-color:var(--ink)}
.pl-sx:focus-visible{outline:2px solid var(--red);outline-offset:2px}

.plot{position:relative;height:clamp(300px,44vh,420px);cursor:crosshair}
.plot svg{width:100%;height:100%;display:block;overflow:visible}

.caliper{
  position:absolute;left:0;right:0;pointer-events:none;opacity:0;transition:opacity .2s;
  border-top:1px dashed var(--red)
}
.plot:hover .caliper{opacity:1}
.caliper b{
  position:absolute;right:0;top:-9px;background:var(--red);color:var(--card);
  font-family:var(--mono);font-size:9px;font-weight:700;padding:2px 6px;letter-spacing:.5px;border-radius:1px
}
.fig{transition:opacity .25s}
.fig.dim{opacity:.22}
/* silhouettes grow up out of the ground line */
.grow{transform:scaleY(0)}
.loaded .grow{transform:scaleY(1);transition:transform 1.15s cubic-bezier(.2,.7,.2,1)}
.fig-cm{opacity:0}
.loaded .fig-cm{opacity:1;transition:opacity .5s ease}
.fig-body{fill:var(--ink)}
.fig:nth-child(1) .fig-body{fill:var(--red)}
.fig-base{stroke:var(--rule);stroke-width:1;stroke-dasharray:3 4}
.fig-cm{font-family:var(--mono);font-size:9.5px;font-weight:700;fill:var(--ink)}
.fig-name{font-family:var(--mono);font-size:10px;fill:var(--pencil);letter-spacing:.8px}
.fig-rank{font-family:var(--mono);font-size:9.5px;font-weight:700;fill:var(--red);letter-spacing:1px}
.bracket{stroke:var(--red);stroke-width:1.2;fill:none}
.bracket-txt{font-family:var(--mono);font-size:10px;font-weight:700;fill:var(--red)}

.plate-foot{
  margin-top:10px;padding-top:9px;border-top:1px solid var(--rule);
  font-family:var(--mono);font-size:10px;letter-spacing:.7px;color:var(--pencil);line-height:1.7
}

/* ---------- scroll cue ---------- */
.cue{
  display:flex;align-items:center;gap:12px;justify-content:center;
  padding:0 0 34px;font-family:var(--mono);font-size:9.5px;letter-spacing:3.5px;
  text-transform:uppercase;color:var(--ink-soft);font-weight:700
}
.cue i{display:block;width:2px;height:40px;background:linear-gradient(var(--rule),var(--red));animation:drop 2.2s ease-in-out infinite}
@keyframes drop{0%,100%{transform:scaleY(.55);opacity:.5}50%{transform:scaleY(1);opacity:1}}

/* ---------- entrance (only hidden when JS is available to reveal it) ---------- */
.js .rise{opacity:0;transform:translateY(18px)}
.loaded .rise{opacity:1;transform:none;transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1)}
.loaded .d1{transition-delay:.05s}.loaded .d2{transition-delay:.15s}
.loaded .d3{transition-delay:.25s}.loaded .d4{transition-delay:.35s}
.loaded .d5{transition-delay:.45s}.loaded .d6{transition-delay:.55s}

/* ============================================================
   PAGE 02 — "THE REEL": a projector running the ranking timelapse
   ============================================================ */
.page{max-width:1520px;margin:0 auto;padding:clamp(26px,5vh,64px) clamp(20px,4vw,56px) clamp(30px,6vh,70px)}
.page-head{
  display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;
  border-bottom:1.5px solid var(--ink);padding-bottom:14px;margin-bottom:24px
}
.page-num{font-family:var(--mono);font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--pencil);white-space:nowrap}
h2{font-family:var(--display);font-size:clamp(1.85rem,3.8vw,3.2rem);font-weight:700;line-height:1;letter-spacing:-.02em}
h2 em{font-style:italic;font-weight:400;color:var(--red)}
.page-deck{font-size:.94rem;color:var(--ink-soft);max-width:60ch;margin-top:12px}

.reel-wrap{display:grid;grid-template-columns:1fr 322px;gap:18px;align-items:start}

/* ---- film frame ---- */
.reel{
  position:relative;background:var(--card);border:1px solid rgba(25,23,19,.3);border-radius:2px;
  box-shadow:3px 5px 0 rgba(25,23,19,.07);padding-bottom:14px;overflow:hidden
}
.sprockets{
  height:15px;border-bottom:1px solid var(--rule);
  background-image:repeating-linear-gradient(to right,rgba(25,23,19,.15) 0 8px,transparent 8px 22px);
  background-size:auto 6px;background-position:0 4px;background-repeat:repeat-x
}
.sprockets.btm{border-bottom:0;border-top:1px solid var(--rule)}

.reel-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding:14px 18px 0;flex-wrap:wrap}
.year{font-family:var(--display);font-weight:700;font-size:clamp(2.3rem,4.8vw,3.9rem);line-height:.82;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.year small{display:block;font-family:var(--mono);font-size:9px;font-weight:400;letter-spacing:2.5px;text-transform:uppercase;color:var(--pencil);margin-bottom:7px}
.year b{color:var(--red)}

.ctrl{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.btn{
  font-family:var(--mono);font-size:9.5px;letter-spacing:1.6px;text-transform:uppercase;
  background:transparent;border:1px solid rgba(25,23,19,.34);color:var(--ink);
  padding:7px 11px;border-radius:2px;cursor:pointer;
  transition:background .18s,color .18s,border-color .18s
}
.btn:hover{background:var(--ink);color:var(--card);border-color:var(--ink)}
.btn.on{background:var(--red);border-color:var(--red);color:var(--card)}
.btn:focus-visible{outline:2px solid var(--red);outline-offset:2px}

/* ---- scrubber styled as filmstrip ---- */
.scrub{position:relative;margin:12px 18px 4px;height:22px}
.scrub input{position:absolute;inset:0;width:100%;height:22px;margin:0;background:transparent;cursor:pointer;-webkit-appearance:none;appearance:none}
.scrub input::-webkit-slider-runnable-track{height:22px;background:
  repeating-linear-gradient(to right,rgba(25,23,19,.10) 0 1px,transparent 1px 12px) center/auto 22px,
  rgba(25,23,19,.045)}
.scrub input::-moz-range-track{height:22px;background:rgba(25,23,19,.045)}
.scrub input::-webkit-slider-thumb{-webkit-appearance:none;width:4px;height:22px;background:var(--red);border:0;border-radius:1px;box-shadow:0 0 0 1px rgba(255,255,255,.6)}
.scrub input::-moz-range-thumb{width:4px;height:22px;background:var(--red);border:0;border-radius:1px}
.scrub input:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.scrub-marks{position:absolute;inset:0;pointer-events:none}
.mark{position:absolute;top:1px;width:1px;height:8px;background:rgba(196,64,42,.6)}
.mark.past{background:var(--red);height:12px}
.scrub-ends{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;color:var(--pencil);margin:0 18px;letter-spacing:1px}

/* the human moment that opens the chapter — pencil on the jamb */
.jamb-quote{
  position:relative;font-family:var(--display);font-style:italic;font-weight:400;
  font-size:clamp(1.02rem,1.75vw,1.42rem);line-height:1.5;color:var(--ink);
  max-width:52ch;margin:2px 0 16px;padding-left:20px
}
.jamb-quote::before{
  content:'';position:absolute;left:0;top:.35em;bottom:.25em;width:3px;border-radius:2px;
  background:linear-gradient(180deg,#c9a463,#8f6428)
}

/* ---- men / women: its own control above each comparison ---- */
.sexbar{
  display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 14px;
  background:var(--card);border:1px solid rgba(25,23,19,.26);border-left:3px solid var(--red);
  border-radius:0 2px 2px 0;padding:10px 14px;box-shadow:2px 3px 0 rgba(25,23,19,.05)
}
.sexbar-l{font-family:var(--mono);font-size:10px;letter-spacing:2.4px;text-transform:uppercase;color:var(--pencil)}
.sexbar-n{font-family:var(--mono);font-size:9px;letter-spacing:.6px;color:var(--pencil);margin-left:auto;max-width:44ch;line-height:1.5}
.sexbtn{
  font-family:var(--mono);font-size:10px;letter-spacing:1.4px;padding:7px 15px;cursor:pointer;
  background:transparent;border:1px solid rgba(25,23,19,.3);color:var(--ink-soft);border-radius:2px;
  transition:background .18s,color .18s,border-color .18s
}
.sexbtn:hover{border-color:var(--ink)}
.sexbtn.on{background:var(--ink);color:var(--card);border-color:var(--ink)}
.sexbtn:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.sexbtn[disabled]{opacity:.35;cursor:not-allowed}
.btn[data-proxy]{display:none}

/* ---- the doorframe ---- */
.jamb-wrap{position:relative;padding:8px 14px 0;display:flex;justify-content:center}
.jamb-wrap svg{width:100%;max-width:660px;margin:0 auto;aspect-ratio:840/1050;height:auto;display:block;touch-action:none}
.jamb-tip{
  position:absolute;pointer-events:none;background:var(--ink);color:var(--card);z-index:4;
  font-family:var(--mono);font-size:9px;letter-spacing:.4px;padding:4px 7px;border-radius:2px;
  transform:translate(-50%,-145%);opacity:0;transition:opacity .14s;white-space:nowrap}
.jamb-tip.on{opacity:1}
.jamb-tip b{color:#e8b866}



.j-brush{stroke:rgba(160,140,102,.16);stroke-width:1.1;fill:none}


.j-grid{stroke:rgba(25,23,19,.05);stroke-width:1}
.j-title{font-family:var(--mono);font-size:12px;letter-spacing:4px;fill:rgba(104,86,56,.8);font-weight:700}
/* the door: swings away from you on its hinges */
.j-door{transition:transform 1.05s cubic-bezier(.42,0,.15,1)}
.j-door.shut{transition-duration:.5s}
.j-door.open{transform:scaleX(.045)}
.j-door-shade{opacity:0;transition:opacity 1.05s ease;pointer-events:none}
.j-door.open .j-door-shade{opacity:1}
.j-doorttl{font-family:var(--mono);font-size:15px;font-weight:700;letter-spacing:4px;fill:rgba(96,80,52,.85)}
.j-doorhint{font-family:var(--mono);font-size:10px;letter-spacing:2px;fill:rgba(120,102,68,.7)}
.j-hinge{stroke:rgba(120,92,30,.45);stroke-width:.8}
#jambNow{opacity:0;transition:opacity .55s ease .35s}
#jambNow.shown{opacity:1}

/* horizontal bars, seen through the opening */
.j-bar{transition:transform .55s cubic-bezier(.3,.85,.2,1)}
.j-bar:hover{cursor:pointer}
.j-track{fill:rgba(104,86,56,.07)}
.j-bar-r{filter:drop-shadow(1px 1.5px 1.5px rgba(90,74,46,.3))}
.j-bar-hi{pointer-events:none}
.j-rank{font-family:var(--mono);font-size:11.5px;font-weight:700;fill:rgba(96,80,52,.6);font-variant-numeric:tabular-nums}
.j-flag{font-size:15px}
.j-name{font-family:var(--mono);font-size:12px;fill:rgba(74,62,40,.9);letter-spacing:.2px}
.j-val{font-family:var(--mono);font-size:12px;font-weight:700;fill:var(--ink);font-variant-numeric:tabular-nums}
.j-delta{font-family:var(--mono);font-size:11px;fill:rgba(96,80,52,.7);font-variant-numeric:tabular-nums}
.j-delta.neg{fill:var(--red)}
.j-ghost{stroke:rgba(35,25,10,.55);stroke-width:1.3;stroke-dasharray:2.5 2;transition:opacity .25s}
#jambNow.no-ghost .j-ghost{opacity:0}
.j-bar.lead .j-name{font-weight:700;fill:var(--ink)}
.j-bar.lead .j-rank{fill:var(--red)}
.j-bar.j-hot .j-bar-r{stroke:var(--red);stroke-width:1.6}
.j-bar.j-hot .j-name,.j-bar.j-hot .j-val{fill:var(--red)}
.j-axcm{font-family:var(--mono);font-size:10.5px;fill:rgba(96,80,52,.75)}
/* the family's marks on the jamb — graphite, not data */
.j-pencil{stroke:rgba(58,52,42,.72);stroke-width:1.8;stroke-linecap:round}
.j-pencil-yr{font-family:var(--mono);font-size:10px;fill:rgba(58,52,42,.7);letter-spacing:.3px}

/* ---- axis ---- */
/* offsets mirror the .rw grid: 20+8 + 20+8 + 92+8 = 156px left, 8+50 = 58px right */
.axis{position:relative;height:22px;margin:6px 18px 0;padding-left:156px}
.axis-in{position:relative;height:100%;margin-right:58px;border-top:1px solid rgba(25,23,19,.25)}
.axis-t{position:absolute;top:0;width:1px;height:5px;background:rgba(25,23,19,.3)}
.axis-l{position:absolute;top:7px;transform:translateX(-50%);font-family:var(--mono);font-size:10px;color:var(--pencil)}
.axis-note{font-family:var(--mono);font-size:9.5px;color:var(--pencil);margin:2px 18px 0;letter-spacing:.6px}

/* ---- side panel ---- */
.side{display:flex;flex-direction:column;gap:14px;align-self:stretch}
.card--grow{display:flex;flex-direction:column;flex:1 1 auto}
.card--grow #standings{flex:0 0 auto}
.card--grow .prov-key{margin-top:auto}

/* ---- live cohort summary under the standings ---- */
.cs-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:9px}
.cs{background:rgba(25,23,19,.035);border:1px solid var(--rule);border-radius:2px;padding:7px 9px}
.cs span{display:block;font-family:var(--mono);font-size:8px;letter-spacing:1.1px;
  text-transform:uppercase;color:var(--pencil);margin-bottom:3px}
.cs b{font-family:var(--mono);font-size:13px;font-weight:700;color:var(--ink);
  font-variant-numeric:tabular-nums}
.cs-row{display:flex;align-items:baseline;justify-content:space-between;gap:8px;
  padding:5px 0;border-bottom:1px dashed var(--rule)}
.cs-k{font-family:var(--mono);font-size:8.5px;letter-spacing:.9px;text-transform:uppercase;color:var(--pencil)}
.cs-row b{font-family:var(--mono);font-size:9.5px;font-weight:700;color:var(--ink);white-space:nowrap}
.cs-src{
  margin-top:9px;padding:7px 9px;border-left:2px solid var(--red);background:rgba(196,64,42,.05);
  font-family:var(--mono);font-size:8.5px;line-height:1.6;color:var(--ink-soft);letter-spacing:.3px}
.cs-src b{color:var(--ink);font-weight:500}

/* ---- data-quality warning inside a country file ---- */
.dq{
  display:block;margin-top:11px;padding:9px 11px;border-left:2px solid var(--red);
  background:rgba(196,64,42,.06);font-size:.8rem;line-height:1.6;color:var(--ink-soft)}
.dq b{color:var(--ink);font-weight:500}
.card{background:var(--card);border:1px solid var(--rule);border-radius:2px;padding:14px;box-shadow:2px 3px 0 rgba(25,23,19,.05)}
.card h4{font-family:var(--mono);font-size:10px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pencil);font-weight:400;margin-bottom:9px;display:flex;justify-content:space-between;align-items:center}
.card h4 span{color:var(--red)}
.tick-body{font-size:.83rem;color:var(--ink-soft);line-height:1.5;margin-top:7px}
.tick-body b{color:var(--ink);font-weight:500}


/* ============================================================
   PAGE 03 — "CASE FILES": click a nation, open its dossier
   ============================================================ */
.files{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;align-items:start}

.file{
  grid-column:span 1;background:var(--card);border:1px solid rgba(25,23,19,.28);border-radius:2px;
  box-shadow:2px 3px 0 rgba(25,23,19,.06);overflow:hidden;
  transition:box-shadow .25s,border-color .25s,transform .25s
}
.file:hover{box-shadow:4px 6px 0 rgba(25,23,19,.1);border-color:rgba(25,23,19,.5)}
.file.open{grid-column:1/-1;border-color:var(--red);box-shadow:4px 7px 0 rgba(196,64,42,.14)}
.file.muted{opacity:.5}

/* ---- closed face: a dossier tab ---- */
.file-face{
  width:100%;text-align:left;background:transparent;border:0;cursor:pointer;
  display:block;padding:0;font:inherit;color:inherit
}
.file-face:focus-visible{outline:2px solid var(--red);outline-offset:-3px}
.file-tab{
  display:flex;justify-content:space-between;align-items:center;gap:10px;
  padding:9px 14px;border-bottom:1px solid var(--rule);background:rgba(25,23,19,.03);
  font-family:var(--mono);font-size:9.5px;letter-spacing:1.8px;text-transform:uppercase;color:var(--pencil)
}
.file-tab .no{color:var(--ink)}
.file-tab .op{color:var(--red);display:flex;align-items:center;gap:5px}
.file-tab .op i{font-style:normal;font-size:11px;line-height:1;transition:transform .3s}
.file.open .file-tab .op i{transform:rotate(45deg)}

.file-body{padding:14px}
.file-top{display:flex;align-items:flex-start;gap:11px}
.file-flag{font-size:26px;line-height:1}
.file-name{font-family:var(--display);font-size:1.32rem;font-weight:700;line-height:1.05;letter-spacing:-.01em}
.file-verdict-tag{font-family:var(--mono);font-size:9px;letter-spacing:1.6px;text-transform:uppercase;color:var(--red);margin-top:4px}
.file-h{margin-left:auto;text-align:right;flex-shrink:0}
.file-h b{font-family:var(--display);font-size:1.7rem;font-weight:700;line-height:1;font-variant-numeric:tabular-nums;display:block}
.file-h span{font-family:var(--mono);font-size:9.5px;color:var(--pencil);letter-spacing:1px}

.file-meta{display:flex;gap:7px;margin-top:11px;flex-wrap:wrap}
.chip{
  font-family:var(--mono);font-size:10px;letter-spacing:.8px;padding:3px 7px;border-radius:2px;
  border:1px solid var(--rule);color:var(--ink-soft);background:rgba(25,23,19,.02);white-space:nowrap
}
.chip.gain{color:#3f6b4a;border-color:rgba(63,107,74,.4)}
.chip.loss{color:var(--red);border-color:rgba(196,64,42,.4)}

.spark{margin-top:12px;height:38px}
.spark svg{width:100%;height:100%;display:block;overflow:visible}
.spark-line{fill:none;stroke-width:1.8;stroke-linejoin:round}
.spark-area{opacity:.1}
.spark-ax{font-family:var(--mono);font-size:9px;fill:var(--pencil)}

/* ---- expanded dossier ---- */
.dossier{
  display:grid;grid-template-rows:0fr;
  transition:grid-template-rows .45s cubic-bezier(.3,.8,.2,1)
}
.file.open .dossier{grid-template-rows:1fr}
.dossier-in{overflow:hidden;min-height:0}
.dossier-pad{
  border-top:1px dashed rgba(25,23,19,.3);margin:0 14px;padding:16px 0 14px;
  display:grid;grid-template-columns:1.15fr 1fr .85fr;gap:22px
}
.d-col h5{
  font-family:var(--mono);font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pencil);
  font-weight:400;margin-bottom:11px;padding-bottom:5px;border-bottom:1px solid var(--rule)
}

/* levers */
.lv{margin-bottom:11px}
.lv-top{display:flex;justify-content:space-between;align-items:baseline;font-family:var(--mono);font-size:10px;color:var(--ink-soft);margin-bottom:4px}
.lv-top em{font-style:normal;color:var(--pencil);letter-spacing:.5px}
.lv-track{position:relative;height:11px;background:rgba(25,23,19,.045);border-left:1px solid rgba(25,23,19,.22)}
.lv-then{position:absolute;left:0;top:0;bottom:0;background:rgba(25,23,19,.16)}
.lv-now{position:absolute;left:0;top:0;bottom:0;width:0;transition:width .9s cubic-bezier(.3,.8,.2,1)}
.file.open .lv-now{width:var(--w)}
.lv-key{font-family:var(--mono);font-size:9px;color:var(--pencil);letter-spacing:.6px;margin-top:9px;line-height:1.6}
.lv-key i{display:inline-block;width:16px;height:7px;vertical-align:0;margin-right:4px}

/* case notes timeline */
.tl{position:relative;padding-left:15px}
.tl::before{content:'';position:absolute;left:3px;top:4px;bottom:6px;width:1px;background:var(--rule)}
.tl-i{position:relative;padding-bottom:11px}
.tl-i::before{content:'';position:absolute;left:-15px;top:5px;width:7px;height:7px;border-radius:50%;background:var(--card);border:1.5px solid var(--pencil)}
.tl-i.key::before{border-color:var(--red);background:var(--red)}
.tl-y{font-family:var(--mono);font-size:9px;font-weight:700;color:var(--ink);letter-spacing:.5px}
.tl-t{font-size:.8rem;color:var(--ink-soft);line-height:1.45}

/* verdict */
.vd{font-family:var(--display);font-size:1rem;font-style:italic;line-height:1.5;color:var(--ink)}
.vd-tell{
  margin-top:12px;padding:10px 12px;background:rgba(196,64,42,.055);border-left:2px solid var(--red);
  font-size:.82rem;color:var(--ink-soft);line-height:1.5
}
.vd-tell b{color:var(--ink);font-weight:500}
.vd-if{margin-top:12px}
.vd-if h6{font-family:var(--mono);font-size:9px;letter-spacing:1.8px;text-transform:uppercase;color:var(--pencil);font-weight:400;margin-bottom:5px}
.vd-if p{font-size:.8rem;color:var(--ink-soft);line-height:1.5}
.vd-genes{
  margin-top:12px;font-family:var(--mono);font-size:9.5px;letter-spacing:.8px;color:var(--pencil);
  padding-top:9px;border-top:1px dashed var(--rule);line-height:1.7
}
.vd-genes b{color:var(--ink)}

.files-note{font-family:var(--mono);font-size:9.5px;color:var(--pencil);letter-spacing:.6px;margin-top:14px;line-height:1.7}

/* ============================================================
   PAGE 03 — "THE ATLAS": globe, fly-in, deep dive
   ============================================================ */
.atlas{display:grid;grid-template-columns:1fr;gap:16px;align-items:start}

.globe-card{background:var(--card);border:1px solid rgba(25,23,19,.3);border-radius:2px;box-shadow:3px 5px 0 rgba(25,23,19,.07);padding:13px 14px 11px}
.globe-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.globe-head h4{font-family:var(--mono);font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pencil);font-weight:400}
.globe-wrap{position:relative;background:
  radial-gradient(60% 60% at 50% 38%,rgba(255,252,244,.7),transparent 70%),rgba(25,23,19,.022);
  border:1px solid var(--rule);border-radius:2px;overflow:hidden}
.globe-wrap canvas{display:block;width:100%;height:clamp(360px,52vh,540px);cursor:grab;touch-action:none}
.globe-wrap canvas.grabbing{cursor:grabbing}
.globe-wrap canvas.pickable{cursor:pointer}
.globe-tip{
  position:absolute;pointer-events:none;background:var(--ink);color:var(--card);
  font-family:var(--mono);font-size:9px;letter-spacing:.5px;padding:4px 7px;border-radius:2px;
  transform:translate(-50%,-140%);opacity:0;transition:opacity .15s;white-space:nowrap;z-index:3}
.globe-tip.on{opacity:1}
.globe-tip b{color:var(--gold,#e8b866)}
.globe-hint{
  position:absolute;left:10px;bottom:8px;font-family:var(--mono);font-size:9px;letter-spacing:1.2px;
  text-transform:uppercase;color:var(--pencil);pointer-events:none;transition:opacity .3s}
.globe-flying .globe-hint{opacity:0}

.globe-legend{display:flex;align-items:center;gap:9px;margin-top:9px;font-family:var(--mono);font-size:9px;color:var(--pencil);letter-spacing:.6px}
.legend-strip{flex:1;height:8px;border-radius:2px;border:1px solid var(--rule)}

.rank-card{background:var(--card);border:1px solid rgba(25,23,19,.3);border-radius:2px;box-shadow:2px 3px 0 rgba(25,23,19,.05);padding:13px 13px 11px}
.rank-card h4{font-family:var(--mono);font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pencil);font-weight:400;margin-bottom:9px;display:flex;justify-content:space-between}
.rank-card h4 span{color:var(--red)}
.rk{
  display:grid;grid-template-columns:18px 17px 1fr 40px;gap:7px;align-items:center;width:100%;
  background:transparent;border:0;border-bottom:1px dashed var(--rule);padding:5px 2px;cursor:pointer;
  font:inherit;color:inherit;text-align:left}
.rk:last-child{border-bottom:0}
.rk:hover,.rk.hot{background:rgba(196,64,42,.06)}
.rk.sel{background:rgba(196,64,42,.12)}
.rk:focus-visible{outline:2px solid var(--red);outline-offset:-2px}
.rk .p{font-family:var(--mono);font-size:9.5px;color:var(--pencil);text-align:right}
.rk .fl{font-size:11px;line-height:1}
.rk .cell{min-width:0}
.rk .nm{display:block;min-width:0;font-family:var(--mono);font-size:10px;color:var(--ink-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rk .vb{display:block;position:relative;height:9px;margin-top:2px;background:rgba(25,23,19,.05)}
.rk .vb i{position:absolute;left:0;top:0;bottom:0;background:var(--ink)}
.rk .vl{font-family:var(--mono);font-size:10px;font-weight:700;text-align:right;font-variant-numeric:tabular-nums}

/* ---- deep dive ---- */
.deep{
  margin-top:16px;background:var(--card);border:1px solid rgba(25,23,19,.3);border-left:3px solid var(--red);
  border-radius:0 2px 2px 0;box-shadow:3px 5px 0 rgba(25,23,19,.07);
  display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s cubic-bezier(.3,.8,.2,1)}
.deep.open{grid-template-rows:1fr}
.deep-in{overflow:hidden;min-height:0}
.deep-pad{padding:15px 17px 17px}
.deep-top{display:flex;align-items:flex-start;gap:13px;padding-bottom:12px;border-bottom:1px solid var(--rule)}
.deep-fl{font-size:30px;line-height:1}
.deep-nm{font-family:var(--display);font-size:1.55rem;font-weight:700;line-height:1.05;letter-spacing:-.01em}
.deep-sub{font-family:var(--mono);font-size:9.5px;letter-spacing:1.6px;text-transform:uppercase;color:var(--red);margin-top:4px}
.deep-h{margin-left:auto;text-align:right}
.deep-h b{font-family:var(--display);font-size:2rem;font-weight:700;line-height:1;display:block;font-variant-numeric:tabular-nums}
.deep-h span{font-family:var(--mono);font-size:9.5px;color:var(--pencil);letter-spacing:1px}
.deep-x{
  background:transparent;border:1px solid rgba(25,23,19,.3);color:var(--ink-soft);cursor:pointer;
  font-family:var(--mono);font-size:10px;letter-spacing:1.4px;text-transform:uppercase;padding:6px 10px;
  border-radius:2px;margin-left:12px;align-self:center}
.deep-x:hover{border-color:var(--red);color:var(--red)}
.deep-grid{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:22px;padding-top:14px}
.deep-grid h5{font-family:var(--mono);font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pencil);font-weight:400;margin-bottom:10px;padding-bottom:5px;border-bottom:1px solid var(--rule)}
.traj svg{width:100%;height:172px;display:block;overflow:visible}
.traj-lg{display:flex;gap:12px;font-family:var(--mono);font-size:9.5px;color:var(--pencil);margin-top:6px}
.traj-lg i{display:inline-block;width:14px;height:2px;vertical-align:3px;margin-right:4px}
.dsp{margin-bottom:9px}
.dsp-t{display:flex;justify-content:space-between;align-items:baseline;font-family:var(--mono);font-size:9.5px;color:var(--ink-soft);margin-bottom:2px}
.dsp-t b{color:var(--ink);font-variant-numeric:tabular-nums}
.dsp svg{width:100%;height:22px;display:block}
.narr{font-size:.85rem;color:var(--ink-soft);line-height:1.6}
.narr b{color:var(--ink);font-weight:500}
.narr .hl{color:var(--red);font-weight:500}
.gdp-box{margin-top:12px;padding:10px 12px;background:rgba(25,23,19,.03);border-left:2px solid var(--pencil)}
.gdp-box .r{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;color:var(--ink-soft);padding:2px 0}
.gdp-box .r b{color:var(--ink);font-variant-numeric:tabular-nums}
.deep-cur{border-top:1px dashed rgba(25,23,19,.3);margin-top:15px;padding-top:14px}

/* ---- standings list beside the door ---- */
.st-row,.st-head{display:grid;grid-template-columns:17px 14px minmax(0,1fr) 32px 32px 40px;
  gap:5px;align-items:center}
.st-row{padding:3px 0;border-bottom:1px dashed var(--rule)}
.st-row:last-child{border-bottom:0}
.st-head{
  padding:0 0 5px;margin-bottom:2px;border-bottom:1px solid rgba(25,23,19,.28);
  font-family:var(--mono);font-size:8px;letter-spacing:.8px;text-transform:uppercase;color:var(--pencil)}
.st-head span:nth-child(n+4){text-align:right}
.st-row .r{font-family:var(--mono);font-size:9px;color:var(--pencil);text-align:right}
.st-row .f{font-size:11px}
.st-row .n{font-family:var(--mono);font-size:9px;color:var(--ink-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.st-row .v0{font-family:var(--mono);font-size:9px;color:var(--pencil);text-align:right;font-variant-numeric:tabular-nums}
.st-row .v{font-family:var(--mono);font-size:9.5px;font-weight:700;text-align:right;font-variant-numeric:tabular-nums}
.st-row .d{font-family:var(--mono);font-size:9px;text-align:right;letter-spacing:.2px;cursor:help;
  font-variant-numeric:tabular-nums}
.st-row .d.up{color:#3f6b4a}
.st-row .d.dn{color:var(--red)}
.st-row .d.hold{color:var(--pencil)}
.st-row.lead .n{color:var(--ink);font-weight:700}
.st-row.lead .r{color:var(--red)}

/* ---- provenance markers: sourced measurements ---- */
.mod,.srcd{
  font-family:var(--mono);font-size:9px;letter-spacing:.4px;padding:1px 3px;border-radius:2px;
  vertical-align:1px;margin-left:4px;white-space:nowrap;cursor:help}
.mod{color:#7a6a4a;background:rgba(184,134,59,.14);border:1px solid rgba(184,134,59,.35)}
.srcd{color:#3f6b4a;background:rgba(63,107,74,.10);border:1px solid rgba(63,107,74,.3)}
.prov-key{
  font-family:var(--mono);font-size:9px;color:var(--pencil);letter-spacing:.5px;line-height:1.8;
  margin-top:10px;padding-top:8px;border-top:1px dashed var(--rule)}

/* ---- the two chapters that carry the argument read heavier ---- */
.page--key{
  position:relative;
  background:
    linear-gradient(180deg,rgba(196,64,42,.045),rgba(196,64,42,0) 340px),
    linear-gradient(180deg,rgba(25,23,19,.028),rgba(25,23,19,0) 100%);
  border-top:2px solid var(--ink);
  border-bottom:1px solid var(--rule);
}
.page--key .page-head{border-bottom-width:2px}
.page--key h2{font-size:clamp(2.1rem,4.4vw,3.7rem)}
.page-kicker{
  font-family:var(--mono);font-size:9.5px;letter-spacing:3.5px;text-transform:uppercase;
  color:var(--red);margin-bottom:10px;display:flex;align-items:center;gap:10px
}
.page-kicker::before{content:'';width:26px;height:2px;background:var(--red)}

/* ============================================================
   PAGE 04 — "THE MIRRORS": same genes, different policy
   ============================================================ */
.m-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.m-tab{
  flex:1 1 220px;text-align:left;background:var(--card);border:1px solid rgba(25,23,19,.26);
  border-radius:2px;padding:11px 13px;cursor:pointer;font:inherit;color:inherit;
  box-shadow:2px 3px 0 rgba(25,23,19,.05);transition:border-color .2s,box-shadow .2s,background .2s
}
.m-tab:hover{border-color:rgba(25,23,19,.5)}
.m-tab:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.m-tab.on{border-color:var(--red);box-shadow:3px 5px 0 rgba(196,64,42,.16);background:rgba(196,64,42,.035)}
.m-tab .n{font-family:var(--mono);font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--pencil)}
.m-tab.on .n{color:var(--red)}
.m-tab .t{font-family:var(--display);font-size:1.02rem;font-weight:700;line-height:1.15;margin:3px 0 2px}
.m-tab .s{font-size:.76rem;color:var(--ink-soft);line-height:1.35}

.m-wrap{display:grid;grid-template-columns:368px 1fr;gap:16px;align-items:start}

/* ---- mirror stage ---- */
.m-stage{background:var(--card);border:1px solid rgba(25,23,19,.28);border-radius:2px;box-shadow:3px 5px 0 rgba(25,23,19,.07);padding:13px 14px 12px}
.m-stage svg{width:100%;height:clamp(230px,30vh,290px);display:block;overflow:visible}
.m-fig{transition:opacity .2s}
.m-body{transition:none}
.m-cm{font-family:var(--mono);font-size:10px;font-weight:700;fill:var(--ink)}
.m-nm{font-family:var(--mono);font-size:9.5px;fill:var(--pencil);letter-spacing:.7px}
.m-gapline{stroke:var(--red);stroke-width:1;stroke-dasharray:3 3}
.m-gapbar{stroke:var(--red);stroke-width:1.3}
.m-ground{stroke:rgba(25,23,19,.5);stroke-width:1.2}

.m-read{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin-top:8px;padding-top:10px;border-top:1px solid var(--rule)}
.m-read .lbl{font-family:var(--mono);font-size:9.5px;letter-spacing:2px;text-transform:uppercase;color:var(--pencil)}
.m-read .big{font-family:var(--display);font-size:2.1rem;font-weight:700;line-height:.9;color:var(--red);font-variant-numeric:tabular-nums}
.m-read .big span{font-family:var(--mono);font-size:.62rem;color:var(--pencil);letter-spacing:1px;margin-left:3px}
.m-read .yr{font-family:var(--display);font-size:1.7rem;font-weight:700;line-height:.9;font-variant-numeric:tabular-nums;text-align:right}
.m-note{font-family:var(--mono);font-size:9px;color:var(--pencil);letter-spacing:.5px;line-height:1.7;margin-top:9px}

/* ---- divergence chart ---- */
.m-chart{background:var(--card);border:1px solid rgba(25,23,19,.28);border-radius:2px;box-shadow:3px 5px 0 rgba(25,23,19,.07);padding:13px 14px 12px}
.m-chead{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.m-chead h4{font-family:var(--mono);font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pencil);font-weight:400}
.m-plot{position:relative}
.m-plot svg{width:100%;height:clamp(250px,34vh,330px);display:block;overflow:visible;cursor:ew-resize;touch-action:none}
.m-grid{stroke:rgba(25,23,19,.07);stroke-width:1}
.m-ax{font-family:var(--mono);font-size:10px;fill:var(--pencil)}
.m-axt{font-family:var(--mono);font-size:9.5px;fill:var(--pencil);letter-spacing:1px}
.m-line{fill:none;stroke-width:2.4;stroke-linejoin:round;stroke-linecap:round;transition:opacity .2s,stroke-width .2s}
.m-line.dim{opacity:.3}
.m-pline{fill:none;stroke-width:1.3;stroke-dasharray:4 3;opacity:.75}
.m-head{stroke:var(--card);stroke-width:1.4}
.m-play{stroke:var(--red);stroke-width:1;stroke-dasharray:2 3}
.m-band{fill:rgba(196,64,42,.07)}
.m-endlbl{font-family:var(--mono);font-size:10px;font-weight:700}
.m-pin{cursor:pointer}
.m-pin circle{fill:var(--card);stroke:var(--pencil);stroke-width:1.3;transition:stroke .2s,fill .2s}
.m-pin.hot circle{fill:var(--red);stroke:var(--red)}
.m-pin text{font-family:var(--mono);font-size:9px;fill:var(--pencil)}

.m-legend{display:flex;gap:12px;flex-wrap:wrap;margin-top:9px}
.m-lg{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10px;color:var(--ink-soft);cursor:pointer;letter-spacing:.4px}
.m-lg i{width:15px;height:3px;border-radius:2px;flex-shrink:0}
.m-lg.off{opacity:.4}

.m-facts{display:flex;gap:6px;flex-wrap:wrap}
.fchip{
  font-family:var(--mono);font-size:9.5px;letter-spacing:1px;text-transform:uppercase;
  border:1px solid rgba(25,23,19,.28);background:transparent;color:var(--ink-soft);
  padding:5px 8px;border-radius:2px;cursor:pointer;transition:background .18s,color .18s,border-color .18s
}
.fchip:hover{border-color:var(--ink)}
.fchip.on{background:var(--ink);color:var(--card);border-color:var(--ink)}
.fchip:focus-visible{outline:2px solid var(--red);outline-offset:2px}

.m-happen{
  margin-top:10px;padding:9px 11px;background:rgba(25,23,19,.03);border-left:2px solid var(--pencil);
  font-size:.82rem;color:var(--ink-soft);line-height:1.5;min-height:52px
}
.m-happen.hit{border-left-color:var(--red);background:rgba(196,64,42,.055)}
.m-happen b{color:var(--ink);font-weight:500}
.m-happen em{font-family:var(--mono);font-size:10px;font-style:normal;color:var(--red);letter-spacing:1px;display:block;margin-bottom:3px}

/* ---- verdict strip ---- */
.m-verdict{display:grid;grid-template-columns:1.4fr 1fr;gap:16px;margin-top:16px}
.m-vmain{background:var(--card);border:1px solid rgba(25,23,19,.28);border-left:3px solid var(--red);border-radius:0 2px 2px 0;padding:16px 18px;box-shadow:2px 3px 0 rgba(25,23,19,.05)}
.m-vmain .q{font-family:var(--display);font-size:1.12rem;font-style:italic;line-height:1.5;color:var(--ink)}
.m-vmain .p{font-size:.85rem;color:var(--ink-soft);line-height:1.6;margin-top:10px}
.m-vmain .p b{color:var(--ink);font-weight:500}
.m-eq{display:grid;gap:10px}
.m-eqbox{background:var(--card);border:1px solid var(--rule);border-radius:2px;padding:12px 13px}
.m-eqbox h6{font-family:var(--mono);font-size:9px;letter-spacing:1.8px;text-transform:uppercase;color:var(--pencil);font-weight:400;margin-bottom:7px}
.m-eqbox .v{font-family:var(--display);font-size:1.5rem;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
.m-eqbox .v.red{color:var(--red)}
.m-eqbox .d{font-size:.76rem;color:var(--ink-soft);line-height:1.45;margin-top:5px}
.m-src{font-family:var(--mono);font-size:9.5px;color:var(--pencil);letter-spacing:.6px;line-height:1.7;margin-top:14px}

/* ============================================================
   PAGE 05 — "THE GROWTH MACHINE": build a country, see how tall
   ============================================================ */
.gm-wrap{display:grid;grid-template-columns:1fr 1.02fr;gap:16px;align-items:start}

.gm-panel{background:var(--card);border:1px solid rgba(25,23,19,.3);border-radius:2px;box-shadow:3px 5px 0 rgba(25,23,19,.07);padding:14px}
.gm-panel h4{
  font-family:var(--mono);font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pencil);
  font-weight:400;margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid var(--rule);
  display:flex;justify-content:space-between;align-items:center
}
.gm-panel h4 b{color:var(--red);font-weight:400}

/* ---- presets ---- */
.gm-presets{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:14px}
.pchip{
  font-family:var(--mono);font-size:9.5px;letter-spacing:.8px;border:1px solid rgba(25,23,19,.28);
  background:transparent;color:var(--ink-soft);padding:5px 7px;border-radius:2px;cursor:pointer;
  transition:background .18s,color .18s,border-color .18s
}
.pchip:hover{border-color:var(--ink)}
.pchip.on{background:var(--ink);color:var(--card);border-color:var(--ink)}
.pchip.wild{border-color:rgba(196,64,42,.5);color:var(--red)}
.pchip.wild:hover{background:var(--red);color:var(--card);border-color:var(--red)}
.pchip:focus-visible{outline:2px solid var(--red);outline-offset:2px}

/* ---- sliders ---- */
.sl{margin-bottom:13px}
.sl-top{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:5px}
.sl-lb{font-size:.82rem;color:var(--ink);line-height:1.25}
.sl-lb em{font-family:var(--mono);font-size:9px;font-style:normal;color:var(--pencil);letter-spacing:.8px;display:block}
.sl-vl{font-family:var(--mono);font-size:10px;font-weight:700;color:var(--red);white-space:nowrap;font-variant-numeric:tabular-nums}
.sl-track{position:relative;height:20px}
.sl-track input{
  position:absolute;inset:0;width:100%;height:20px;margin:0;-webkit-appearance:none;appearance:none;
  background:transparent;cursor:pointer
}
.sl-track input::-webkit-slider-runnable-track{height:6px;margin-top:7px;background:rgba(25,23,19,.1);border-radius:3px}
.sl-track input::-moz-range-track{height:6px;background:rgba(25,23,19,.1);border-radius:3px}
.sl-track input::-webkit-slider-thumb{
  -webkit-appearance:none;width:13px;height:13px;margin-top:-3.5px;border-radius:50%;
  background:var(--ink);border:2px solid var(--card);box-shadow:0 0 0 1px rgba(25,23,19,.35)}
.sl-track input::-moz-range-thumb{
  width:13px;height:13px;border-radius:50%;background:var(--ink);border:2px solid var(--card);box-shadow:0 0 0 1px rgba(25,23,19,.35)}
.sl-track input:focus-visible{outline:2px solid var(--red);outline-offset:1px}
.sl-fill{position:absolute;left:0;top:7px;height:6px;border-radius:3px;background:var(--red);opacity:.55;pointer-events:none}
.sl-bench{position:absolute;top:3px;width:1px;height:14px;background:rgba(25,23,19,.55);pointer-events:none}
.sl-bench::after{
  content:'NL';position:absolute;top:-9px;left:50%;transform:translateX(-50%);
  font-family:var(--mono);font-size:9px;color:var(--pencil)}

/* ---- switches + generations ---- */
.gm-rows{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:4px}
.sw{display:flex;flex-direction:column;gap:6px}
.swbtn{
  display:flex;align-items:center;gap:9px;background:transparent;border:1px solid rgba(25,23,19,.24);
  border-radius:2px;padding:8px 10px;cursor:pointer;text-align:left;font:inherit;color:var(--ink-soft);
  transition:border-color .18s,background .18s
}
.swbtn i{
  width:26px;height:14px;border-radius:8px;background:rgba(25,23,19,.16);position:relative;flex-shrink:0;
  transition:background .2s}
.swbtn i::after{content:'';position:absolute;top:2px;left:2px;width:10px;height:10px;border-radius:50%;background:var(--card);transition:left .2s}
.swbtn.on{border-color:var(--red);background:rgba(196,64,42,.05);color:var(--ink)}
.swbtn.on i{background:var(--red)}
.swbtn.on i::after{left:14px}
.swbtn span{font-family:var(--mono);font-size:10px;letter-spacing:.6px;line-height:1.3}
.swbtn:focus-visible{outline:2px solid var(--red);outline-offset:2px}

.gen{display:flex;gap:0;border:1px solid rgba(25,23,19,.28);border-radius:2px;overflow:hidden}
.gen button{
  flex:1;background:transparent;border:0;border-right:1px solid rgba(25,23,19,.16);cursor:pointer;
  padding:9px 4px;font-family:var(--mono);font-size:10px;letter-spacing:.6px;color:var(--ink-soft);
  transition:background .18s,color .18s}
.gen button:last-child{border-right:0}
.gen button.on{background:var(--ink);color:var(--card)}
.gen-note{font-family:var(--mono);font-size:9px;color:var(--pencil);line-height:1.6;margin-top:6px}

/* ---- readout / certificate ---- */
.gm-cert{position:relative;background:var(--card);border:1px solid rgba(25,23,19,.36);border-radius:2px;box-shadow:3px 5px 0 rgba(25,23,19,.08);padding:16px;overflow:hidden}
.gm-cert::before{
  content:'';position:absolute;inset:5px;border:1px solid rgba(25,23,19,.14);pointer-events:none;border-radius:1px}
.cert-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;position:relative}
.cert-ttl{font-family:var(--mono);font-size:9px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pencil)}
.cert-name{font-family:var(--display);font-size:clamp(1.15rem,2vw,1.6rem);font-weight:700;line-height:1.1;margin-top:4px;letter-spacing:-.01em}
.cert-reroll{
  font-family:var(--mono);font-size:9px;letter-spacing:1px;background:transparent;border:1px solid rgba(25,23,19,.26);
  color:var(--pencil);padding:4px 7px;border-radius:2px;cursor:pointer;white-space:nowrap}
.cert-reroll:hover{border-color:var(--red);color:var(--red)}

.cert-mid{display:grid;grid-template-columns:78px 1fr;gap:14px;align-items:end;margin-top:14px;position:relative}
.cert-fig svg{width:100%;height:132px;display:block;overflow:visible}
.cert-num{font-family:var(--display);font-size:clamp(2.8rem,6vw,4.4rem);font-weight:700;line-height:.84;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.cert-num small{font-family:var(--mono);font-size:.9rem;letter-spacing:1px;color:var(--pencil);margin-left:5px}
.cert-sub{font-family:var(--mono);font-size:10px;letter-spacing:.8px;color:var(--ink-soft);margin-top:7px;line-height:1.6}
.cert-sub b{color:var(--red)}

.record{
  position:absolute;top:12px;right:14px;transform:rotate(-7deg);padding:5px 9px;
  border:1.5px solid var(--red);border-radius:2px;color:var(--red);
  font-family:var(--mono);font-size:9px;letter-spacing:1.6px;text-transform:uppercase;
  opacity:0;transition:opacity .3s;pointer-events:none;background:rgba(250,247,240,.85)}
.record.show{opacity:.9}

/* ranking strip */
.rank-strip{position:relative;height:44px;margin-top:14px;border-top:1px solid var(--rule);padding-top:16px}
.rs-ax{position:absolute;left:0;right:0;top:16px;height:1px;background:rgba(25,23,19,.25)}
.rs-t{position:absolute;top:12px;width:1px;height:8px;background:rgba(25,23,19,.3)}
.rs-n{position:absolute;top:22px;transform:translateX(-50%);font-family:var(--mono);font-size:9px;color:var(--pencil);white-space:nowrap}
.rs-you{position:absolute;top:4px;width:2px;height:20px;background:var(--red);transition:left .35s cubic-bezier(.3,.8,.2,1)}
.rs-you::after{
  content:attr(data-l);position:absolute;top:-11px;left:50%;transform:translateX(-50%);
  font-family:var(--mono);font-size:9px;font-weight:700;color:var(--red);white-space:nowrap}

/* waterfall */
.wf-row{display:grid;grid-template-columns:126px 1fr 50px;gap:8px;align-items:center;margin-bottom:5px}
.wf-lb{font-family:var(--mono);font-size:9.5px;color:var(--ink-soft);letter-spacing:.3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wf-tr{position:relative;height:12px;background:rgba(25,23,19,.04)}
.wf-bar{position:absolute;left:0;top:0;bottom:0;background:var(--ink);transition:width .4s cubic-bezier(.3,.8,.2,1)}
.wf-bar.base{background:rgba(25,23,19,.22)}
.wf-vl{font-family:var(--mono);font-size:10px;font-weight:700;color:var(--ink);text-align:right;font-variant-numeric:tabular-nums}
.wf-vl.zero{color:var(--pencil);font-weight:400}

/* diagnostics */
.gm-diag{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.dg{background:rgba(25,23,19,.03);border:1px solid var(--rule);border-radius:2px;padding:10px 11px}
.dg h6{font-family:var(--mono);font-size:9px;letter-spacing:1.6px;text-transform:uppercase;color:var(--pencil);font-weight:400;margin-bottom:6px}
.dg .v{font-family:var(--display);font-size:1.25rem;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
.dg .v.red{color:var(--red)}
.dg .d{font-size:.76rem;color:var(--ink-soft);line-height:1.45;margin-top:5px}
.gauge{height:7px;background:rgba(25,23,19,.1);border-radius:4px;overflow:hidden;margin:7px 0 3px}
.gauge i{display:block;height:100%;background:var(--red);border-radius:4px;transition:width .4s}

.reality{
  margin-top:12px;padding:10px 12px;border-left:2px solid var(--pencil);background:rgba(25,23,19,.03);
  font-size:.8rem;color:var(--ink-soft);line-height:1.5}
.reality b{color:var(--ink);font-weight:500}
.reality em{font-family:var(--mono);font-size:9.5px;font-style:normal;letter-spacing:1.2px;color:var(--red);display:block;margin-bottom:3px;text-transform:uppercase}

/* ---- disclaimer ---- */
.gm-disc{
  margin-top:18px;position:relative;border:1.5px dashed rgba(196,64,42,.55);border-radius:2px;
  background:rgba(196,64,42,.04);padding:20px 22px}
.gm-disc .stamp2{
  font-family:var(--mono);font-size:clamp(.72rem,1.7vw,1.05rem);font-weight:700;letter-spacing:3px;
  text-transform:uppercase;color:var(--red);line-height:1.4}
.gm-disc p{font-size:.86rem;color:var(--ink-soft);line-height:1.65;margin-top:10px;max-width:80ch}
.gm-disc p b{color:var(--ink);font-weight:500}
.gm-disc .sig{
  font-family:var(--mono);font-size:9px;letter-spacing:1.6px;text-transform:uppercase;color:var(--pencil);margin-top:12px}

/* ============================================================
   PAGE 06 — "MEASURE YOURSELF": personal, for fun
   ============================================================ */
.me-wrap{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start}
.me-form{background:var(--card);border:1px solid rgba(25,23,19,.3);border-radius:2px;box-shadow:3px 5px 0 rgba(25,23,19,.07);padding:16px}
.me-form h4,.me-out h4{
  font-family:var(--mono);font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pencil);
  font-weight:400;margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid var(--rule);
  display:flex;justify-content:space-between}

.fld{margin-bottom:13px}
.fld > label{display:block;font-size:.82rem;color:var(--ink);margin-bottom:5px}
.fld > label em{font-family:var(--mono);font-size:9px;font-style:normal;color:var(--pencil);letter-spacing:.8px;display:block}
.fld select{
  width:100%;font:inherit;font-size:.85rem;padding:8px 9px;color:var(--ink);
  background:rgba(25,23,19,.03);border:1px solid rgba(25,23,19,.24);border-radius:2px;cursor:pointer}
.fld select:focus-visible{outline:2px solid var(--red);outline-offset:1px}

.seg{display:flex;border:1px solid rgba(25,23,19,.24);border-radius:2px;overflow:hidden}
.seg button{
  flex:1;background:transparent;border:0;border-right:1px solid rgba(25,23,19,.14);cursor:pointer;
  padding:8px 4px;font-family:var(--mono);font-size:10px;letter-spacing:.6px;color:var(--ink-soft);
  transition:background .18s,color .18s}
.seg button:last-child{border-right:0}
.seg button.on{background:var(--ink);color:var(--card)}
.seg button:focus-visible{outline:2px solid var(--red);outline-offset:-2px}

.ph-top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px}
.ph-vl{font-family:var(--mono);font-size:10px;font-weight:700;color:var(--red);font-variant-numeric:tabular-nums}

.me-go{
  width:100%;margin-top:6px;padding:15px;background:var(--red);color:var(--card);border:0;border-radius:2px;
  font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;
  cursor:pointer;transition:transform .12s,box-shadow .2s,background .2s;
  box-shadow:3px 4px 0 rgba(25,23,19,.22)}
.me-go:hover{background:#a8341f}
.me-go:active{transform:translate(2px,3px);box-shadow:1px 1px 0 rgba(25,23,19,.22)}
.me-go:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
.me-again{
  background:transparent;border:1px solid rgba(25,23,19,.3);color:var(--ink-soft);
  font-family:var(--mono);font-size:10px;letter-spacing:1.4px;text-transform:uppercase;
  padding:7px 11px;border-radius:2px;cursor:pointer;margin-top:10px}
.me-again:hover{border-color:var(--red);color:var(--red)}

/* ---- output ---- */
.me-out{
  position:relative;background:var(--card);border:1px solid rgba(25,23,19,.3);border-radius:2px;
  box-shadow:3px 5px 0 rgba(25,23,19,.07);padding:16px;min-height:340px;
  display:flex;flex-direction:column}
.me-idle{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:10px;
  color:var(--pencil)}
.me-idle .tape{font-family:var(--mono);font-size:9px;letter-spacing:3px;text-transform:uppercase}
.me-idle .big{font-family:var(--display);font-size:1.15rem;font-style:italic;color:var(--ink-soft);max-width:32ch;line-height:1.5}
.me-res{display:none}
.me-res.show{display:block;animation:fadeUp .5s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

.res-num{font-family:var(--display);font-size:clamp(3rem,7vw,4.8rem);font-weight:700;line-height:.82;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.res-num small{font-family:var(--mono);font-size:.85rem;letter-spacing:1px;color:var(--pencil);margin-left:5px}
.res-ft{font-family:var(--mono);font-size:10px;letter-spacing:1.4px;color:var(--ink-soft);margin-top:7px}
.res-ci{font-family:var(--mono);font-size:10px;letter-spacing:.8px;color:var(--pencil);margin-top:5px;line-height:1.6}

.res-band{position:relative;height:34px;margin:14px 0 4px}
.rb-ax{position:absolute;left:0;right:0;top:16px;height:1px;background:rgba(25,23,19,.22)}
.rb-ci{position:absolute;top:11px;height:11px;background:rgba(196,64,42,.16);border-left:1px solid rgba(196,64,42,.5);border-right:1px solid rgba(196,64,42,.5)}
.rb-you{position:absolute;top:5px;width:2px;height:23px;background:var(--red)}
.rb-m{position:absolute;top:12px;width:1px;height:9px;background:rgba(25,23,19,.4)}
.rb-l{position:absolute;top:23px;transform:translateX(-50%);font-family:var(--mono);font-size:9px;color:var(--pencil);white-space:nowrap}

.res-figs{display:flex;align-items:flex-end;gap:14px;justify-content:center;margin:12px 0 4px}
.res-figs svg{height:118px;display:block;overflow:visible}

.pcbox{margin-top:12px}
.pcrow{margin-bottom:9px}
.pcrow .t{display:flex;justify-content:space-between;font-family:var(--mono);font-size:9.5px;color:var(--ink-soft);margin-bottom:3px;letter-spacing:.4px}
.pcrow .t b{color:var(--red)}
.pcbar{height:7px;background:rgba(25,23,19,.08);border-radius:4px;overflow:hidden}
.pcbar i{display:block;height:100%;background:var(--red);border-radius:4px;transition:width .8s cubic-bezier(.3,.8,.2,1)}

.res-brk{margin-top:12px;padding-top:10px;border-top:1px dashed var(--rule)}
.brow{display:grid;grid-template-columns:1fr 60px;gap:8px;font-family:var(--mono);font-size:10px;color:var(--ink-soft);padding:3px 0}
.brow b{text-align:right;color:var(--ink);font-variant-numeric:tabular-nums}
.brow b.pos{color:#3f6b4a}.brow b.neg{color:var(--red)}
.brow.tot{border-top:1px solid var(--rule);margin-top:4px;padding-top:6px;color:var(--ink);font-weight:700}

.res-quip{
  margin-top:12px;padding:11px 13px;background:rgba(196,64,42,.055);border-left:2px solid var(--red);
  font-family:var(--display);font-size:.98rem;font-style:italic;color:var(--ink);line-height:1.5}
.res-foot{font-family:var(--mono);font-size:9px;color:var(--pencil);letter-spacing:.6px;line-height:1.7;margin-top:10px}

/* ---- "why fifteen" note between the hero and the reel ---- */
.why15{
  max-width:1520px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(10px,2vh,20px)}
.why15-in{
  background:var(--card);border:1px solid rgba(25,23,19,.28);border-left:3px solid var(--red);
  border-radius:0 2px 2px 0;padding:20px 24px;box-shadow:2px 3px 0 rgba(25,23,19,.05)}
.why15-k{
  font-family:var(--mono);font-size:9.5px;letter-spacing:3.2px;text-transform:uppercase;
  color:var(--red);margin-bottom:14px}
.why15-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.4fr);gap:clamp(18px,3vw,40px)}
.why15-lead{
  font-family:var(--display);font-size:clamp(1.05rem,1.5vw,1.3rem);font-style:italic;
  line-height:1.5;color:var(--ink)}
.why15-lead b{font-style:normal;font-weight:700}
.why15-body p{font-size:.86rem;color:var(--ink-soft);line-height:1.65}
.why15-list{margin:9px 0 0;padding-left:0;list-style:none;counter-reset:w15}
.why15-list li{
  position:relative;padding-left:26px;margin-bottom:8px;
  font-size:.85rem;color:var(--ink-soft);line-height:1.6}
.why15-list li::before{
  counter-increment:w15;content:counter(w15,decimal-leading-zero);position:absolute;left:0;top:1px;
  font-family:var(--mono);font-size:9px;color:var(--red);letter-spacing:.5px}
.why15-list b{color:var(--ink);font-weight:500}
.why15-cav{
  margin-top:12px;padding-top:11px;border-top:1px dashed var(--rule);
  font-size:.8rem!important;color:var(--pencil)!important}
.why15-cav b{color:var(--ink-soft);font-weight:500}
@media (max-width:820px){ .why15-grid{grid-template-columns:1fr;gap:14px} }

/* ---- appendix section: read me + FAQ ---- */
.appx{
  max-width:1520px;margin:0 auto;padding:clamp(30px,5vh,60px) clamp(20px,4vw,56px) clamp(20px,3vh,36px);
  border-top:2px solid var(--ink)}
.appx-head{max-width:60ch;margin-bottom:20px}
.appx-kick{font-family:var(--mono);font-size:9.5px;letter-spacing:3.5px;text-transform:uppercase;
  color:var(--red);margin-bottom:12px}
.appx-head h3{font-family:var(--display);font-size:clamp(1.5rem,3vw,2.3rem);font-weight:700;
  line-height:1.15;letter-spacing:-.01em}
.appx-lead{margin-top:10px;font-size:.9rem;color:var(--ink-soft);line-height:1.6}
.appx .readme{margin-top:12px}
.rm-q{padding:14px 0;border-bottom:1px dashed var(--rule)}
.rm-q:last-child{border-bottom:0}
.rm-q h5{
  font-family:var(--display);font-size:1.02rem;font-weight:700;color:var(--ink);
  line-height:1.3;margin-bottom:7px}
.rm-q p{font-size:.86rem;color:var(--ink-soft);line-height:1.68}
.rm-q p+p{margin-top:7px}
.rm-q b{color:var(--ink);font-weight:500}
.rm-q .rm-tbl{margin:9px 0}

/* GenAI usage list inside the Read me */
.rm-ai{margin:9px 0 0;padding-left:0;list-style:none;counter-reset:ai}
.rm-ai li{
  position:relative;padding-left:26px;margin-bottom:10px;
  font-size:.85rem;color:var(--ink-soft);line-height:1.6}
.rm-ai li::before{
  counter-increment:ai;content:counter(ai);position:absolute;left:0;top:1px;
  font-family:var(--mono);font-size:9px;color:var(--red);font-weight:700;
  width:16px;height:16px;line-height:16px;text-align:center;
  border:1px solid var(--red);border-radius:50%}
.rm-ai b{color:var(--ink);font-weight:600}

/* ---- collapsible read me / appendix ---- */
.readme{
  margin-top:18px;background:var(--card);border:1px solid rgba(25,23,19,.28);border-radius:2px;
  box-shadow:2px 3px 0 rgba(25,23,19,.05)}
.readme>summary{
  cursor:pointer;list-style:none;padding:13px 16px;display:flex;align-items:center;gap:10px;
  font-family:var(--mono);font-size:10px;letter-spacing:2.4px;text-transform:uppercase;color:var(--ink);
  transition:background .18s}
.readme>summary::-webkit-details-marker{display:none}
.readme>summary::after{
  content:'+';margin-left:auto;font-family:var(--mono);font-size:15px;line-height:1;color:var(--red);
  transition:transform .22s}
.readme[open]>summary::after{content:'−'}
.readme>summary:hover{background:rgba(196,64,42,.04)}
.readme>summary:focus-visible{outline:2px solid var(--red);outline-offset:-2px}
.readme>summary b{font-weight:400;color:var(--pencil);letter-spacing:1.4px;text-transform:none}
.readme-body{padding:0 16px 16px;border-top:1px dashed var(--rule)}
.rm-sec{padding-top:14px}
.rm-sec h5{
  font-family:var(--mono);font-size:9.5px;letter-spacing:1.8px;text-transform:uppercase;
  color:var(--red);font-weight:400;margin-bottom:6px}
.rm-sec p{font-size:.84rem;color:var(--ink-soft);line-height:1.65}
.rm-sec p+p{margin-top:7px}
.rm-sec b{color:var(--ink);font-weight:500}
.rm-tbl{width:100%;border-collapse:collapse;margin-top:8px;font-size:.78rem}
.rm-tbl th,.rm-tbl td{
  text-align:left;padding:5px 8px 5px 0;border-bottom:1px dashed var(--rule);
  font-family:var(--mono);font-size:9.5px;color:var(--ink-soft);letter-spacing:.3px}
.rm-tbl th{color:var(--pencil);text-transform:uppercase;letter-spacing:1.4px}
.rm-tbl td:last-child,.rm-tbl th:last-child{text-align:right;font-variant-numeric:tabular-nums}
.rm-tbl tr:last-child td{border-bottom:0}
.rm-flag{
  margin-top:12px;padding:10px 12px;background:rgba(196,64,42,.055);border-left:2px solid var(--red);
  font-size:.82rem;color:var(--ink-soft);line-height:1.6}
.rm-flag b{color:var(--ink);font-weight:500}

/* ============================================================
   PAGE 07 — CLOSING
   ============================================================ */
.close{
  border-top:2px solid var(--ink);
  background:linear-gradient(180deg,rgba(196,64,42,.05),rgba(196,64,42,0) 300px);margin-top:10px;padding:clamp(34px,6vh,64px) clamp(20px,4vw,56px) clamp(34px,6vh,60px);
  max-width:1520px;margin-left:auto;margin-right:auto}
.close-kick{font-family:var(--mono);font-size:9.5px;letter-spacing:3.5px;text-transform:uppercase;color:var(--red);margin-bottom:20px}
.close h2{font-size:clamp(1.3rem,2.8vw,2.2rem);max-width:28ch;line-height:1.25}

/* ---- the closing statement ----
   Same display face as the rest of the deck, but sized for three sentences
   rather than one headline, and with the parallel pair bound by a hanging rule. */
.close-say{
  font-size:clamp(1.1rem,2vw,1.6rem);       /* sized for a single flowing pair + a punch below */
  max-width:56ch;line-height:1.5;letter-spacing:-.005em;font-weight:400;
  color:var(--ink-soft)}
.close-say .cs-line{
  display:inline;position:relative;padding-left:0}
.close-say .cs-line::before{
  content:none}
.close-say .cs-line:first-child::before{background:#3f6b4a}
.close-say .cs-line:nth-child(2)::before{background:var(--red)}
.close-say b{font-weight:700;color:var(--ink)}
.close-say em{font-style:italic;font-weight:400;color:var(--red);white-space:nowrap}
.close-say .cs-line:first-child em{color:#3f6b4a}
.close-say .cs-punch{
  display:block;width:fit-content;margin-top:.7em;padding-top:.5em;
  border-top:2px solid var(--ink);
  font-size:1.2em;font-weight:700;font-style:normal;line-height:1.2;
  color:var(--ink);text-wrap:balance}
@media (max-width:620px){
  .close-say{max-width:none}
  .close-say .cs-line{padding-left:16px}
}
.close h2 em{display:block}
.credits{font-family:var(--mono);font-size:9.5px;color:var(--pencil);letter-spacing:.6px;line-height:1.9;margin-top:24px;padding-top:16px;border-top:1px solid var(--rule)}
.credits b{color:var(--ink)}
.credits a{color:var(--red);text-decoration:underline;text-underline-offset:2px}
.credits a:hover{color:var(--ink)}
.credits a:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.credits > br + br{content:''}
.credits .sig{color:var(--red);letter-spacing:2.4px;text-transform:uppercase;margin-top:8px;display:block}
.totop{
  background:transparent;border:1px solid rgba(25,23,19,.3);color:var(--ink-soft);cursor:pointer;
  font-family:var(--mono);font-size:10px;letter-spacing:1.6px;text-transform:uppercase;padding:9px 14px;
  border-radius:2px;margin-top:18px}
.totop:hover{border-color:var(--red);color:var(--red)}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media(max-width:1180px){
  .reel-wrap{grid-template-columns:1fr}
  .side{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
}
