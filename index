      h += `<line class="j-brush" x1="${VBW-gx}" y1="${AW}" x2="${VBW-gx-1.5}" y2="${FLOOR}"/>`;
    }
    for (let i = 0; i < 4; i++)
      h += `<line class="j-brush" x1="0" y1="${8+i*15}" x2="${VBW}" y2="${10+i*15}"/>`;
    h += `<path d="M${AW-5},${FLOOR*.66} q4,-9 9,-3 q-5,7 -9,3 z" fill="rgba(146,124,86,.22)"/>`;
    [FLOOR*.18, FLOOR*.5, FLOOR*.85].forEach(y => {
      h += `<circle cx="${AW/2}" cy="${y.toFixed(1)}" r="1.9" fill="rgba(122,104,72,.35)"/>`;
      h += `<circle cx="${AW/2}" cy="${(y-.6).toFixed(1)}" r=".9" fill="rgba(255,255,252,.7)"/>`;
    });

    /* ---- brass hinges on the hinge (left) jamb ---- */
    [HEAD + 52, (HEAD+FLOOR)/2 - 26, FLOOR - 112].forEach(y => {
      h += `<rect class="j-hinge" x="${JW-30}" y="${y.toFixed(1)}" width="22" height="58" rx="2" fill="url(#brass)"/>`;
      h += `<circle cx="${JW-19}" cy="${(y+12).toFixed(1)}" r="2.3" fill="rgba(120,92,30,.55)"/>`;
      h += `<circle cx="${JW-19}" cy="${(y+46).toFixed(1)}" r="2.3" fill="rgba(120,92,30,.55)"/>`;
    });

    /* ---- the family's pencil marks, graphite on beige ---- */
    const MARKS = [[.28,"'71"],[.36,"'74"],[.45,"'78"],[.54,"'82"],[.62,"'86"],[.71,"'91"]];
    MARKS.forEach(([t, yr]) => {
      const y = HEAD + t*(FLOOR - HEAD);
      h += `<line class="j-pencil" x1="${AW+7}" y1="${y.toFixed(1)}" x2="${JW-34}" y2="${(y-1.2).toFixed(1)}"/>`;
      h += `<text class="j-pencil-yr" x="${AW+7}" y="${(y-4).toFixed(1)}">${yr}</text>`;
    });
    h += `<text class="j-pencil-yr" x="${AW+6}" y="${(HEAD + .21*(FLOOR-HEAD)).toFixed(1)}" opacity=".85">kids</text>`;

    h += `<text class="j-title" x="${VBW/2}" y="${AW+24}" text-anchor="middle">A CENTURY OF GROWING UP</text>`;
    h += `<text class="j-title" x="${VBW/2}" y="${AW+42}" text-anchor="middle" opacity=".7" font-size="9.5">1900 — 1996</text>`;

    /* ---- cm axis along the skirting ---- */
    for (let cm = Math.ceil(lo/5)*5; cm <= hi; cm += 5){
      const x = bx(cm);
      if (x < TR_X0 - 1 || x > TR_X1 + 1) continue;
      h += `<line class="j-grid" x1="${x.toFixed(1)}" y1="${ROW_TOP}" x2="${x.toFixed(1)}" y2="${ROW_BOT+6}"/>`;
      h += `<text class="j-axcm" x="${x.toFixed(1)}" y="${ROW_BOT+20}" text-anchor="middle">${cm}</text>`;
    }
    h += `<text class="j-axcm" x="${TR_X1+6}" y="${ROW_BOT+20}" opacity=".75">cm</text>`;
    h += `<line x1="${TR_X0}" y1="${ROW_BOT+6}" x2="${TR_X1}" y2="${ROW_BOT+6}" stroke="rgba(104,86,56,.3)" stroke-width="1"/>`;

    gStatic.innerHTML = h;
  }

  /* ---------------- the door itself ---------------- */
  function drawDoor(){
    const W = OX1 - OX0, H = FLOOR - HEAD;
    const st = 34, mid = HEAD + H*0.46;                 // stile width, lock-rail height
    let h = `<g class="j-door" id="jDoor" style="transform-origin:${OX0}px ${(HEAD+FLOOR)/2}px">`;
    h += `<rect x="${OX0}" y="${HEAD}" width="${W}" height="${H}" fill="url(#doorPaint)"/>`;
    // recessed panels: two upper, two lower
    const panel = (x, y, w, hh) =>
        `<rect x="${x}" y="${y}" width="${w}" height="${hh}" rx="2" fill="url(#doorPanel)"/>`
      + `<rect x="${x}" y="${y}" width="${w}" height="${hh}" rx="2" fill="none" stroke="rgba(126,108,74,.4)" stroke-width="1.4"/>`
      + `<path d="M${x+2},${y+hh-2} V${y+2} H${x+w-2}" fill="none" stroke="rgba(255,255,252,.6)" stroke-width="1.2"/>`;
    const pw = (W - st*3)/2, uh = mid - HEAD - st*1.5, lh = FLOOR - mid - st*1.5;
    h += panel(OX0+st, HEAD+st, pw, uh);
    h += panel(OX0+st*2+pw, HEAD+st, pw, uh);
    h += panel(OX0+st, mid+st*.5, pw, lh);
    h += panel(OX0+st*2+pw, mid+st*.5, pw, lh);
    // brush direction on the stiles
    for (let i = 0; i < 5; i++)
      h += `<line class="j-brush" x1="${OX0+4+i*6}" y1="${HEAD}" x2="${OX0+5+i*6}" y2="${FLOOR}"/>`;
    // knob on the opening edge
    h += `<circle cx="${OX1-26}" cy="${mid-8}" r="9" fill="url(#brass)" stroke="rgba(120,92,30,.5)" stroke-width="1"/>`;
    h += `<circle cx="${OX1-28}" cy="${mid-11}" r="3" fill="rgba(255,250,225,.6)"/>`;
    h += `<rect x="${OX1-33}" y="${mid+6}" width="14" height="22" rx="2" fill="url(#brass)" stroke="rgba(120,92,30,.45)" stroke-width=".8"/>`;
    // the chapter title, painted on the door
    h += `<text class="j-doorttl" x="${OX0+W/2}" y="${mid-46}" text-anchor="middle">THE SCOREBOARD</text>`;
    h += `<text class="j-doorttl" x="${OX0+W/2}" y="${mid-26}" text-anchor="middle" font-size="9" opacity=".75">REWOUND</text>`;
    h += `<text class="j-doorhint" x="${OX0+W/2}" y="${mid+64}" text-anchor="middle">press play to open</text>`;
    // shading that deepens as it swings away
    h += `<rect class="j-door-shade" x="${OX0}" y="${HEAD}" width="${W}" height="${H}" fill="url(#doorShade)"/>`;
    h += `</g>`;
    SVG.insertAdjacentHTML('beforeend', h);
    gDoor = document.getElementById('jDoor');
  }

  let doorOpen = false;
  function openDoor(then){
    doorOpen = true;                       // set first: with no door (reduced
    if (!gDoor) return then && then();     // motion) play() must not re-enter
    gDoor.classList.remove('shut');         // full, slow swing on the way open
    gDoor.classList.add('open');
    gBars.classList.add('shown');
    if (reduce) return then && then();
    setTimeout(() => then && then(), 1150);
  }
  function closeDoor(){
    if (!gDoor) return;
    doorOpen = false;
    gDoor.classList.add('shut');            // shorter transition on the way closed
    gDoor.classList.remove('open');
    gBars.classList.remove('shown');
  }

  /* ---------------- horizontal bars ---------------- */
  const BAR = {};
  function buildBars(){
    const bh = Math.min(20, ROW_H - 9);
    gBars.innerHTML = NATIONS.map(d => `
      <g class="j-bar" data-c="${d.c}">
        <text class="j-rank" x="${OX0 + PAD + RK_W - 4}" y="${(bh/2 + 4).toFixed(1)}" text-anchor="end"></text>
        <text class="j-flag" x="${OX0 + PAD + RK_W + 4}" y="${(bh/2 + 5).toFixed(1)}"></text>
        <text class="j-name" x="${OX0 + PAD + RK_W + FL_W + 6}" y="${(bh/2 + 3.5).toFixed(1)}">${d.n}</text>
        <rect class="j-track" x="${TR_X0}" y="0" width="${(TR_X1-TR_X0).toFixed(1)}" height="${bh}" rx="2"/>
        <rect class="j-bar-r" x="${TR_X0}" y="0" width="0" height="${bh}" rx="2" fill="${d.col}"/>
        <rect class="j-bar-hi" x="${TR_X0}" y="0" width="0" height="${(bh*0.34).toFixed(1)}" rx="2" fill="rgba(255,255,255,.22)"/>
        <line class="j-ghost" y1="-3" y2="${(bh+3).toFixed(1)}"/>
        <text class="j-val" y="${(bh/2 + 4).toFixed(1)}"></text>
        <text class="j-delta" x="${OX1 - PAD}" y="${(bh/2 + 4).toFixed(1)}" text-anchor="end"></text>
      </g>`).join('');
    [...gBars.children].forEach(g => {
      const c = g.dataset.c, d = NATIONS.find(x => x.c === c);
      BAR[c] = {g, rk:g.querySelector('.j-rank'), fl:g.querySelector('.j-flag'),
                r:g.querySelector('.j-bar-r'), hi:g.querySelector('.j-bar-hi'),
                gh:g.querySelector('.j-ghost'), v:g.querySelector('.j-val'),
                dl:g.querySelector('.j-delta')};
      BAR[c].fl.textContent = d.f;
      g.addEventListener('pointerenter', () => showTip(c));
      g.addEventListener('pointerleave', hideTip);
    });
  }

  function drawBars(y){
    const rows = NATIONS.map(d => ({d, cm: d.at(y)})).sort((a,b) => b.cm - a.cm);
    rows.forEach((o, i) => {
      const b = BAR[o.d.c], w = Math.max(1, bx(o.cm) - TR_X0);
      b.g.setAttribute('transform', `translate(0,${(ROW_TOP + i*ROW_H).toFixed(1)})`);
      b.r.setAttribute('width', w.toFixed(1));
      b.hi.setAttribute('width', w.toFixed(1));
      b.rk.textContent = i + 1;
      b.v.setAttribute('x', (TR_X0 + w + 7).toFixed(1));
      b.v.textContent = o.cm.toFixed(1);
      const gx = bx(o.d.base);
      b.gh.setAttribute('x1', gx.toFixed(1)); b.gh.setAttribute('x2', gx.toFixed(1));
      const dv = o.cm - o.d.base;
      b.dl.textContent = (dv >= 0 ? '+' : '') + dv.toFixed(1);
      b.dl.classList.toggle('neg', dv < 0);
      b.g.classList.toggle('lead', i === 0);
    });
  }

  /* the standings list mirrors the bars as text */
  const stEl = document.getElementById('standings');
  const rank1900 = rankMapAt(Y0);                  // rank index at the 1900 cohort
  function drawStandings(y){
    if (!stEl) return;
    const yr = Math.round(y);
    document.getElementById('stYear').textContent = '1900 → ' + yr;
    const rows = NATIONS.map(d => ({d, base: d.at(Y0), cm: d.at(y)})).sort((a,b) => b.cm - a.cm);
    const head = `<div class="st-head" aria-hidden="true"><span></span><span></span>` +
      `<span>Country</span><span>1900</span><span>${yr}</span><span>Moved</span></div>`;
    stEl.innerHTML = head + rows.map((o,i) => {
      const gain = o.cm - o.base;                  // cm gained since the 1900 cohort
      const cls  = gain > 0.05 ? 'up' : gain < -0.05 ? 'dn' : 'hold';
      const txt  = (gain >= 0 ? '+' : '') + gain.toFixed(1);
      const rk   = rank1900[o.d.c] - i;            // >0 = climbed the table since 1900
      const rkTxt = rk === 0 ? 'held its 1900 rank'
        : `${rk > 0 ? 'up' : 'down'} ${Math.abs(rk)} ${Math.abs(rk) === 1 ? 'place' : 'places'} in the table`;
      const lbl = `${o.d.n}: ${o.base.toFixed(1)} cm in 1900, ${o.cm.toFixed(1)} cm in ${yr}, ` +
                  `${gain >= 0 ? 'up' : 'down'} ${Math.abs(gain).toFixed(1)} cm — ${rkTxt}`;
      return `<div class="st-row${i===0?' lead':''}" title="${lbl}" aria-label="${lbl}">` +
        `<span class="r">${i+1}</span>` +
        `<span class="f">${o.d.f}</span><span class="n">${o.d.n}</span>` +
        `<span class="v0">${o.base.toFixed(1)}</span>` +
        `<span class="v" style="color:${o.d.col}">${o.cm.toFixed(1)}</span>` +
        `<span class="d ${cls}">${txt}</span></div>`;
    }).join('');
    drawSummary(rows, yr);
  }

  /* live read-out of the cohort currently on screen */
  function drawSummary(rows, yr){
    const csY = document.getElementById('csYear');
    if (!csY) return;
    const cms = rows.map(o => o.cm);
    const mean = cms.reduce((a,b) => a+b, 0) / cms.length;
    const gains = rows.map(o => ({n:o.d.n, f:o.d.f, g:o.cm - o.base}))
                      .sort((a,b) => b.g - a.g);
    const top = gains[0], bot = gains[gains.length-1];
    const fmtG = o => `${o.f} ${o.n} ${o.g >= 0 ? '+' : ''}${o.g.toFixed(1)} cm`;

    csY.textContent = yr;
    document.getElementById('csMean').textContent = mean.toFixed(1) + ' cm';
    document.getElementById('csSpread').textContent = (Math.max(...cms) - Math.min(...cms)).toFixed(1) + ' cm';
    document.getElementById('csUp').textContent = yr === Y0 ? '—' : fmtG(top);
    document.getElementById('csDn').textContent = yr === Y0 ? '—' : fmtG(bot);
    document.getElementById('csSrc').innerHTML = yr >= 1970
      ? `<b>Measured cohort.</b> Heights for 1970, 1980, 1990 and 1996 are observed NCD-RisC means.`
      : `<b>Reconstructed cohort.</b> This dataset starts at the 1966 birth year, so everything before
         1970 is interpolated from a 1900 anchor. Read it as a sketch.`;
  }

  function showTip(c){
    if (!doorOpen) return;
    const d = NATIONS.find(x => x.c === c);
    const cm = d.at(year), gain = cm - d.base;
    const rect = BAR[c].r.getBoundingClientRect(), wrapR = SVG.parentElement.getBoundingClientRect();
    jTip.classList.add('on');
    jTip.style.left = (rect.left - wrapR.left + rect.width) + 'px';
    jTip.style.top  = (rect.top - wrapR.top) + 'px';
    jTip.innerHTML = `${d.f} ${d.n} · <b>${cm.toFixed(1)} cm</b> · ${gain>=0?'+':''}${gain.toFixed(1)} since 1900`;
    [...gBars.children].forEach(g => g.classList.toggle('j-hot', g.dataset.c === c));
  }
  function hideTip(){
    jTip.classList.remove('on');
    [...gBars.children].forEach(g => g.classList.remove('j-hot'));
  }

  // event marks on the scrubber
  const marksEl = document.getElementById('scrubMarks');
  EVENTS.forEach(e => marksEl.insertAdjacentHTML('beforeend',
    `<div class="mark" data-y="${e.y}" style="left:${((e.y-Y0)/(Y1-Y0)*100).toFixed(2)}%"></div>`));
  const markEls = [...marksEl.children];

  /* ---------------------------------------------------------
     RENDER a single frame
     --------------------------------------------------------- */
  const yearNow = document.getElementById('yearNow');
  const scrub = document.getElementById('scrub');

  function frame(y, updateScrub){
    const iy = Math.round(y);
    yearNow.innerHTML = iy >= Y1 ? '1996<b>.</b>' : String(iy);
    if (updateScrub) scrub.value = y;

    drawBars(y);
    drawStandings(y);

    markEls.forEach(m => m.classList.toggle('past', +m.dataset.y <= iy));
  }

  /* ---------------------------------------------------------
     PLAYBACK
     --------------------------------------------------------- */
  const SPEEDS = [0.5, 1, 2];
  let si = 0, year = Y0, playing = false, raf = null, last = 0;
  const YPS = 15;                                  // years per second at 1×
  const btnPlay = document.getElementById('btnPlay');

  function tick(now){
    if (!playing) return;
    const dt = Math.min((now - last) / 1000, 0.1); last = now;
    year += dt * YPS * SPEEDS[si];
    if (year >= Y1){ year = Y1; frame(year, true); stop(true); return; }
    frame(year, true);
    raf = requestAnimationFrame(tick);
  }
  function play(){
    if (playing) return;
    if (!doorOpen){ openDoor(play); return; }        // the door swings open first
    if (year >= Y1) year = Y0;
    playing = true; btnPlay.textContent = '❚❚ Pause'; btnPlay.classList.add('on');
    last = performance.now(); raf = requestAnimationFrame(tick);
  }
  function stop(done){
    playing = false; cancelAnimationFrame(raf);
    btnPlay.textContent = done ? '↺ Replay 1900' : '▶ Play';
    btnPlay.classList.remove('on');
  }
  btnPlay.addEventListener('click', () => playing ? stop(false) : play());
  document.getElementById('btnReplay').addEventListener('click', () => {
    stop(); year = Y0; frame(year, true);
    // shut briskly, hold a beat, then swing it properly open again
    closeDoor(); setTimeout(() => openDoor(play), 640);
  });
  document.getElementById('btnSpeed').addEventListener('click', e => {
    si = (si + 1) % SPEEDS.length; e.currentTarget.textContent = SPEEDS[si] + '×';
  });
  /* hover the doorway to read a nation off the frame */
  SVG.addEventListener('pointermove', e => {
    const r = SVG.getBoundingClientRect();
    const vx = (e.clientX - r.left)/r.width * VBW, vy = (e.clientY - r.top)/r.height * VBH;
    let best = null, bd = 1e9;
    NATIONS.forEach(d => {
      const dy = Math.abs(jy(d.at(year)) - vy), dx = Math.abs(jx(year) - vx);
      const dist = dy + dx*0.25;
      if (dy < 12 && dist < bd){ bd = dist; best = d; }
    });
    [...gNow.querySelectorAll('.j-row')].forEach(g => g.classList.toggle('j-hot', best && g.dataset.c === best.c));
    if (best){
      const cm = best.at(year), gain = cm - best.base;
      jTip.classList.add('on');
      jTip.style.left = (e.clientX - r.left) + 'px';
      jTip.style.top = (e.clientY - r.top) + 'px';
      jTip.innerHTML = `${best.f} ${best.n} · <b>${cm.toFixed(1)} cm</b> · ${gain>=0?'+':''}${gain.toFixed(1)} since 1900`;
    } else jTip.classList.remove('on');
  }, {passive:true});
  SVG.addEventListener('pointerleave', () => {
    jTip.classList.remove('on');
    [...gNow.querySelectorAll('.j-row')].forEach(g => g.classList.remove('j-hot'));
  });

  document.getElementById('btnSex').addEventListener('click', e => {
    SEX = SEX === 'm' ? 'fm' : 'm';
    e.currentTarget.textContent = SEX === 'm' ? '\u2642 Men' : '\u2640 Women';
    rebuild(); drawFrame(); frame(year, true);
  });
  document.getElementById('btnGhost').addEventListener('click', e => {
    const off = gBars.classList.toggle('no-ghost');
    e.currentTarget.classList.toggle('on', !off);
  });
  scrub.addEventListener('input', () => { stop(false); year = +scrub.value; frame(year, false); });

  // spacebar / arrows while the reel is on screen
  let onScreen = false;
  window.addEventListener('keydown', e => {
    if (!onScreen) return;
    if (e.code === 'Space'){ e.preventDefault(); playing ? stop(false) : play(); }
    if (e.code === 'ArrowRight' || e.code === 'ArrowLeft'){
      stop(false);
      year = Math.min(Y1, Math.max(Y0, year + (e.code === 'ArrowRight' ? 1 : -1)));
      frame(year, true);
    }
  });

  // autoplay once, when the reel scrolls into view
  let hasPlayed = false;
  new IntersectionObserver(es => es.forEach(en => {
    onScreen = en.isIntersecting;
    if (en.isIntersecting && !hasPlayed && !reduce){ hasPlayed = true; setTimeout(() => openDoor(play), 500); }
    else if (!en.isIntersecting && playing) stop(false);
  }), {threshold:.45}).observe(document.getElementById('reel'));

  drawFrame(); buildBars(); if (!reduce) drawDoor(); else gBars.classList.add('shown');
  frame(Y0, true);
  if (reduce) frame(Y1, true);   // static final frame when motion is reduced
})();
</script>

